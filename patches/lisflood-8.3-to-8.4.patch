+      }
+      BcArgs bc{};
+      for (int k = 0; k < 4; ++k) {
+        if (sides[k].type == mwdg2::BC_HVAR || sides[k].type == mwdg2::BC_QVAR)
+          sides[k].inlet = sides[k].series.at(now);
