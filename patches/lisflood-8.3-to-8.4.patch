+      float hArgs[4] = {dt, static_cast<float>(solver.DepthThresh), 0.0f, 0.0f};
+      runtime.dispatch("nug_update_h", {leafBuf, recBuf, qBuf, srcLeafBuf, srcTypeBuf, srcValueBuf, vRecBuf, vLeafBuf},
+                       {hCount, hArgs}, {sizeof(hCount), sizeof(hArgs)}, leafCount);
+      // edge discharge (after the wet/dry limiting) for the mass balance
+      double edgeIn = 0.0;
+      for (uint32_t r : edgeRecords) {
+        const uint32_t d = records[r].dir;
+        edgeIn += ((d == DIR_N || d == DIR_W) ? 1.0 : -1.0) * qData[r];
+      }
+      if (edgeIn >= 0) { boundCs.Qin += edgeIn; boundCs.VolInMT += edgeIn * dt; }
+      else { boundCs.Qout -= edgeIn; boundCs.VolOutMT -= edgeIn * dt; }
+      if (lossesEnabled) {
+        project();
+        @autoreleasepool {
+          id<MTLCommandBuffer> command = [runtime.queue commandBuffer];
+          id<MTLComputeCommandEncoder> enc = [command computeCommandEncoder];
+          losses.encode(enc, depthBuf, zeroQ, zeroQ, false, 0, 0, 0.0f, demBuf, nodata,
+                        static_cast<float>(solver.DepthThresh), dt, solver.t);
+          [enc endEncoding]; [command commit]; [command waitUntilCompleted];
+        }
+        losses.collect();
+        losses.take_interval_volume();
+        uint32_t layout[4] = {leafCount, uint32_t(xsz), uint32_t(ysz), 0};
+        runtime.dispatch("nug_restrict_losses", {leafBuf, depthBuf, demBuf, losses.residual_buffer(), removedBuf},
+                         {layout, &nodata}, {sizeof(layout), sizeof(nodata)}, leafCount);
+        double removed = 0.0;
+        const float *rem = static_cast<const float *>(removedBuf.contents);
+        for (uint32_t i = 0; i < leafCount; ++i) removed += rem[i];
+        removed *= cellArea;
+        lossTotal += removed;
+        integratedLossTime += dt;
+        boundCs.VolOutMT += static_cast<NUMERIC_TYPE>(removed);
+        pars.InfilTotalLoss += static_cast<NUMERIC_TYPE>(removed);
+      }
+
+      if (solver.t > 0) solver.MinTstep = std::min<NUMERIC_TYPE>(solver.MinTstep, dt);
+      const NUMERIC_TYPE tStart = solver.t;
+      solver.t += dt;
+      solver.itCount += 1;
+      if (verbose) std::printf("t=%f\tdt=%f\n", double(tStart), double(dt));
+
+      if (solver.t >= pars.MassTotal) {
+        project();
+        // update_max at the mass output times, as cuda acc_nugrid
+        if (arrays.maxH)
+          for (size_t i = 0; i < rasterCells; ++i)
+            if (arrays.H[i] > solver.DepthThresh) {
+              if (arrays.initHtm[i] == NULLVAL) arrays.initHtm[i] = solver.t / C(3600.0);
+              arrays.totalHtm[i] += solver.Tstep / C(3600.0);
+              if (arrays.H[i] > arrays.maxH[i]) { arrays.maxH[i] = arrays.H[i]; arrays.maxHtm[i] = solver.t / C(3600.0); }
+            }
+        if (lossesEnabled) {
+          char path[512];
+          std::snprintf(path, sizeof(path), "%s.loss", filenames.resrootname);
+          FILE *fp = std::fopen(path, firstLossRecord ? "w" : "a");
+          if (fp) {
+            if (firstLossRecord) std::fprintf(fp, "time,integrated_time,loss_volume,water_volume\n");
+            double water = 0.0;
+            for (uint32_t i = 0; i < leafCount; ++i) {
+              const Leaf &f = leafData[i];
+              int valid = 0;
+              for (uint32_t y = f.y0; y < f.y0 + f.span && y < uint32_t(ysz); ++y)
+                for (uint32_t x = f.x0; x < f.x0 + f.span && x < uint32_t(xsz); ++x)
+                  if (std::fabs(static_cast<float>(arrays.DEM[(ysz - 1 - y) * xsz + x]) - nodata) >= 1e-6f) ++valid;
+              water += double(f.h) * valid * cellArea;
+            }
+            std::fprintf(fp, "%.17g,%.17g,%.17g,%.17g\n", double(solver.t), integratedLossTime, lossTotal, water);
+            std::fclose(fp);
+            firstLossRecord = false;
+          }
+        }
+        if (states.save_stages == ON) {
+          const float *vLeaf = static_cast<const float *>(vLeafBuf.contents);
+          // through LISFLOOD's open .stage/.velocity files (lisflood.cpp)
+          auto record = [&](FILE *fp, bool velocity) {
+            if (!fp) return;
+            std::fprintf(fp, "%12.3f", double(solver.t));
+            for (int i = 0; i < stage.Nstages; ++i) {
+              const int x = static_cast<int>((stage.stage_loc_x[i] - pars.blx) / pars.dx);
+              const int y = static_cast<int>((stage.stage_loc_y[i] - pars.bly) / pars.dx);
+              double v = 0.0;
+              if (x >= 0 && y >= 0 && x < side && y < side) {
+                const int leaf = finestLeaf[size_t(y) * side + x];
+                v = velocity ? vLeaf[leaf] : leafData[leaf].h;
+              }
+              std::fprintf(fp, "%10.4f", v);
+            }
+            std::fputc('\n', fp);
+            std::fflush(fp);
+          };
+          record(files ? files->stage_fp : nullptr, false);
+          if (states.voutput_stage == ON) record(files ? files->vel_fp : nullptr, true);
+        }
+        update_mass_stats(&states, &pars, &solver, &boundCs, &arrays);
+        write_mass_stats(files, &pars, &solver, &boundCs);
+      }
+      if (solver.t >= pars.SaveTotal) {
+        project();
+        if (states.save_vtk == ON) {  // write_soln_vtk.cu: the leaves as quads
+          char path[800];
+          std::snprintf(path, sizeof(path), "%s-%.4d.vtk", filenames.resrootname, pars.SaveNo);
+          FILE *fp = std::fopen(path, "w");
+          if (fp) {
+            const int prec = pars.output_precision;
+            const float *vLeaf = static_cast<const float *>(vLeafBuf.contents);
+            std::fprintf(fp, "# vtk DataFile Version 3.0\nMultiresolution flow and topo data\nASCII\n\n"
+                             "DATASET UNSTRUCTURED_GRID\nPOINTS %u float\n", leafCount * 4);
+            for (uint32_t i = 0; i < leafCount; ++i) {
+              const Leaf &f = leafData[i];
+              const double c = f.dx, x = pars.blx + f.li * c, y = pars.bly + f.lj * c;
+              std::fprintf(fp, "%.*f %.*f %.*f\n%.*f %.*f %.*f\n%.*f %.*f %.*f\n%.*f %.*f %.*f\n",
+                           prec, x, prec, y, prec, 1.0, prec, x, prec, y + c, prec, 1.0,
+                           prec, x + c, prec, y, prec, 1.0, prec, x + c, prec, y + c, prec, 1.0);
+            }
+            std::fprintf(fp, "\nCELLS %u %u\n", leafCount, leafCount * 5);
+            for (uint32_t i = 0; i < leafCount; ++i)
+              std::fprintf(fp, "4 %u %u %u %u\n", 4 * i, 4 * i + 1, 4 * i + 2, 4 * i + 3);
+            std::fprintf(fp, "\nCELL_TYPES %u\n", leafCount);
+            for (uint32_t i = 0; i < leafCount; ++i) std::fprintf(fp, "8\n");
+            std::fprintf(fp, "\nCELL_DATA %u\n\nSCALARS z0 float 1\nLOOKUP_TABLE default\n", leafCount);
+            for (uint32_t i = 0; i < leafCount; ++i) std::fprintf(fp, "%.*f\n", prec, double(leafData[i].z));
+            std::fprintf(fp, "\nSCALARS h float 1\nLOOKUP_TABLE default\n");
+            for (uint32_t i = 0; i < leafCount; ++i) std::fprintf(fp, "%.*f\n", prec, double(leafData[i].h));
+            std::fprintf(fp, "\nSCALARS v float 1\nLOOKUP_TABLE default\n");
+            for (uint32_t i = 0; i < leafCount; ++i) std::fprintf(fp, "%.*f\n", prec, double(vLeaf[i]));
+            std::fclose(fp);
+          }
+        }
+        write_regular_output(&filenames, &solver, &states, &pars, &arrays, nullptr);
+        pars.SaveTotal += pars.SaveInt;
+        pars.SaveNo += 1;
+      }
+      }
+    }
+    project();
+    write_max_field(&filenames, &states, &pars, &arrays);
+    if (verbose) std::printf("\nFinished Metal ACC_NUGRID.\n\n");
+  } catch (const std::exception &e) {
+    std::fprintf(stderr, "ERROR: Metal ACC_NUGRID: %s\n", e.what());
+    std::exit(1);
+  }
+  }
+}
+
+} } } // namespace lis::metal::acc_nugrid
+#endif
diff --git a/metal/adaptive/metal_adaptive_bc.h b/metal/adaptive/metal_adaptive_bc.h
new file mode 100644
index 0000000..9b01893
--- /dev/null
+++ b/metal/adaptive/metal_adaptive_bc.h
@@ -0,0 +1,161 @@
+#pragma once
+// Boundary conditions and point sources of the adaptive solvers (MWDG2,
+// HWFV1), read and updated as cuda/adaptive does it (classes/Boundary.h,
+// classes/PointSources.h): one segment per side (the first bcifile line for
+// that side), cell range int((lower-origin)/dx) .. int((upper-origin)/dx)-1,
+// cell index y counted from the south edge, and time series interpolated with
+// the same row stepping.
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace lis { namespace metal { namespace mwdg2 {
+
+enum AdaptiveBcType { BC_CLOSED = 0, BC_FREE = 1, BC_HFIX = 2, BC_HVAR = 3, BC_QFIX = 4, BC_QVAR = 5 };
+enum AdaptiveSideIndex { SIDE_N = 0, SIDE_E = 1, SIDE_S = 2, SIDE_W = 3 };
+
+struct AdaptiveSeries {
+  std::vector<float> time, value;
+  int row = 0;
+  // Boundary::update_inlet / PointSources::update_src
+  float at(float now) {
+    const int n = static_cast<int>(value.size());
+    if (n == 0) return 0.0f;
+    if (row - 1 < n && row + 1 < n) {
+      float t1 = time[row], t2 = time[row + 1];
+      if (now > t2 && row + 2 < n) { ++row; t1 = time[row]; t2 = time[row + 1]; }
+      return value[row] + (value[row + 1] - value[row]) / (t2 - t1) * (now - t1);
+    }
+    return value[n - 1];
+  }
+};
+
+struct AdaptiveSide {
+  int type = BC_CLOSED;
+  int start = 0, end = -1;    // cell indices along the side
+  float inlet = 0.0f;
+  AdaptiveSeries series;
+  bool contains(int cell) const { return type != BC_CLOSED && cell >= start && cell <= end; }
+};
+
+struct AdaptivePointSource {
+  int x = 0, y = 0;           // finest cell, y from the south edge
+  int type = BC_HFIX;
+  float value = 0.0f;
+  AdaptiveSeries series;
+};
+
+inline int adaptiveBcType(const char *name) {
+  if (!std::strncmp(name, "FREE", 4)) return BC_FREE;
+  if (!std::strncmp(name, "HFIX", 4)) return BC_HFIX;
+  if (!std::strncmp(name, "HVAR", 4)) return BC_HVAR;
+  if (!std::strncmp(name, "QFIX", 4)) return BC_QFIX;
+  if (!std::strncmp(name, "QVAR", 4)) return BC_QVAR;
+  return BC_CLOSED;
+}
+
+// The named series in bdyfile: "name" line, then "<rows> <seconds|minutes|hours>",
+// then rows of "value time".
+inline AdaptiveSeries readAdaptiveSeries(const char *bdyfile, const char *name) {
+  if (!bdyfile || !bdyfile[0])
+    throw std::runtime_error(std::string("time series ") + name + " needs a bdyfile");
+  FILE *fp = std::fopen(bdyfile, "r");
+  if (!fp) throw std::runtime_error(std::string("cannot open bdyfile ") + bdyfile);
+  char str[255], buf[64] = {0};
+  const size_t len = std::strlen(name);
+  while (std::strncmp(buf, name, len)) {
+    if (!std::fgets(str, sizeof(str), fp)) {
+      std::fclose(fp);
+      throw std::runtime_error(std::string("time series ") + name + " not found in " + bdyfile);
+    }
+    buf[0] = 0;
+    std::sscanf(str, "%63s", buf);
+  }
+  int rows = 0;
+  buf[0] = 0;
+  if (std::fgets(str, sizeof(str), fp)) std::sscanf(str, "%d %63s", &rows, buf);
+  if (rows <= 0) { std::fclose(fp); throw std::runtime_error(std::string("empty time series ") + name); }
+  const float mult = !std::strncmp(buf, "seconds", 7) ? 1.0f : !std::strncmp(buf, "minutes", 7) ? 60.0f : 3600.0f;
+  AdaptiveSeries series;
+  for (int i = 0; i < rows; ++i) {
+    float v = 0, t = 0;
+    if (!std::fgets(str, sizeof(str), fp)) break;
+    std::sscanf(str, "%f %f", &v, &t);
+    series.value.push_back(v);
+    series.time.push_back(t * mult);
+  }
+  std::fclose(fp);
+  return series;
+}
+
+struct AdaptiveBoundaries {
+  AdaptiveSide side[4];
+  std::vector<AdaptivePointSource> sources;
+
+  bool any() const {
+    for (const auto &s : side) if (s.type != BC_CLOSED) return true;
+    return !sources.empty();
+  }
+
+  void read(const char *bcifile, const char *bdyfile, double xmin, double ymin,
+            double cell, int xsz, int ysz) {
+    if (!bcifile || !bcifile[0]) return;
+    const char dirs[4] = {'N', 'E', 'S', 'W'};
+    for (int k = 0; k < 4; ++k) {
+      FILE *fp = std::fopen(bcifile, "r");
+      if (!fp) throw std::runtime_error(std::string("cannot open bcifile ") + bcifile);
+      char str[255];
+      while (std::fgets(str, sizeof(str), fp)) {
+        char dir = 0, type[16] = {0}, extra[64] = {0};
+        float lower = 0, upper = 0;
+        if (std::sscanf(str, "%c %f %f %15s %63s", &dir, &lower, &upper, type, extra) < 4 ||
+            dir != dirs[k])
+          continue;
+        AdaptiveSide &s = side[k];
+        s.type = adaptiveBcType(type);
+        const double origin = (k == SIDE_N || k == SIDE_S) ? xmin : ymin;
+        s.start = static_cast<int>((lower - origin) / cell);
+        s.end = static_cast<int>((upper - origin) / cell) - 1;
+        const int length = (k == SIDE_N || k == SIDE_S) ? xsz : ysz;
+        if (s.start < 0) s.start = 0;
+        if (s.end > length - 1) s.end = length - 1;
+        if (s.type == BC_HFIX || s.type == BC_QFIX) s.inlet = std::strtof(extra, nullptr);
+        if (s.type == BC_HVAR || s.type == BC_QVAR) s.series = readAdaptiveSeries(bdyfile, extra);
+        break;
+      }
+      std::fclose(fp);
+    }
+    FILE *fp = std::fopen(bcifile, "r");
+    char str[255];
+    while (fp && std::fgets(str, sizeof(str), fp)) {
+      char point = 0, type[16] = {0}, extra[64] = {0};
+      float xs = 0, ys = 0;
+      if (std::sscanf(str, "%c %f %f %15s %63s", &point, &xs, &ys, type, extra) < 4 || point != 'P')
+        continue;
+      AdaptivePointSource p;
+      p.x = static_cast<int>((xs - xmin) / cell);
+      p.y = static_cast<int>((ys - ymin) / cell);
+      p.type = adaptiveBcType(type);
+      if (p.type == BC_HFIX || p.type == BC_QFIX) p.value = std::strtof(extra, nullptr);
+      else if (p.type == BC_HVAR || p.type == BC_QVAR) p.series = readAdaptiveSeries(bdyfile, extra);
+      else continue;
+      if (p.x < 0 || p.y < 0 || p.x >= xsz || p.y >= ysz) continue;
+      sources.push_back(p);
+    }
+    if (fp) std::fclose(fp);
+  }
+
+  // Boundaries::update_all_inlets / PointSources::update_all_srcs
+  void update(float now) {
+    for (auto &s : side)
+      if (s.type == BC_HVAR || s.type == BC_QVAR) s.inlet = s.series.at(now);
+    for (auto &p : sources)
+      if (p.type == BC_HVAR || p.type == BC_QVAR) p.value = p.series.at(now);
+  }
+};
+
+} } } // namespace lis::metal::mwdg2
diff --git a/metal/adaptive/metal_mwdg2_flow.metal b/metal/adaptive/metal_mwdg2_flow.metal
new file mode 100644
index 0000000..181a6e7
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_flow.metal
@@ -0,0 +1,890 @@
+#include "metal_mwdg2_mra.metal"
+
+constant float mw_sqrt3 = 1.7320508075688772f;
+
+inline float3 mw_basis(uint4 cell, float2 point) {
+    float2 local = 2.0f * (point-float2(cell.xy))/float(cell.z)-1.0f;
+    return float3(1.0f,mw_sqrt3*local);
+}
+
+inline float mw_bed(device const float *scales, uint node, float3 basis) {
+    uint p=node*12+9;
+    return dot(float3(scales[p],scales[p+1],scales[p+2]),basis);
+}
+
+// MRA stores free-surface elevation eta (not depth h), together with qx, qy
+// and bed z. Recover the conserved depth used by the SWE operator as eta-z.
+inline float3 mw_state(device const float *scales, uint node, float3 basis) {
+    float3 state;
+    uint p=node*12;
+    state.x=dot(float3(scales[p],scales[p+1],scales[p+2]),basis)-
+            mw_bed(scales,node,basis);
+    state.y=dot(float3(scales[p+3],scales[p+4],scales[p+5]),basis);
+    state.z=dot(float3(scales[p+6],scales[p+7],scales[p+8]),basis);
+    return state;
+}
+
+// CUDA's adaptive neighbor lookup promotes a finer face neighbor to its
+// ancestor at the current leaf's level. Coarse leaves therefore use the
+// common parent polynomial along the entire face, rather than extrapolating
+// whichever fine segment happened to be stored first.
+// Domain-edge markers in the neighbour records: 0xffffffff closed (CUDA's
+// default edge), 0xfffffffe FREE, and two west inflows that cuda/adaptive
+// hard-codes for its benchmarks, chosen there by the DEM file name
+// (add_ghost_cells.cu): Monai's non-reflective wave and Oregon's wavemaker.
+constant uint MW_GHOST_WAVE = 0xfffffffdu;
+constant uint MW_GHOST_MAKER = 0xfffffffcu;
+constant uint MW_GHOST_MIN = 0xfffffffcu;
+
+// operators/non_reflective_wave.cuh (still depth 0.13535 m, as in CUDA)
+inline float2 mw_non_reflective_wave(float hInlet, float dt, float dxl, float hp,
+                                     float up, float hb, float ub, float g) {
+    int k = 0, cond = 0;
+    float Delta = 1e-6f, xa = -dxl / 2.0f, p0 = dxl / 2.0f, p1 = p0 - dxl / 2.0f, dp = 0.0f;
+    float f0 = (p0 - xa) + dt * ((ub - (p0 - xa) / dxl * (ub - up)) - sqrt(g * (hb - (p0 - xa) / dxl * (hb - hp))));
+    while (k <= 100 && cond == 0) {
+        float df = 1.0f + dt * ((up - ub) / dxl - 0.5f * pow(g * (hb - (p0 - xa) / dxl * (hb - hp)), -0.5f) * (g * (hp - hb) / dxl));
+        if (abs(df) <= 0.0f) { cond = 1; dp = p1 - p0; p1 = p0; }
+        else { dp = f0 / df; p1 = p0 - dp; }
+        float f1 = (p1 - xa) + dt * ((ub - (p1 - xa) / dxl * (ub - up)) - sqrt(g * (hb - (p1 - xa) / dxl * (hb - hp))));
+        float relerr = abs(dp) / abs(p1);
+        if (relerr < Delta) cond = 2;
+        if (abs(f1) < Delta) cond = 3;
+        if (relerr <= Delta && abs(f1) < Delta) cond = 4;
+        p0 = p1; f0 = f1; ++k;
+    }
+    float hr = hb - (hb - hp) * (p1 - xa) / dxl;
+    float ur = ub - (ub - up) * (p1 - xa) / dxl;
+    float betaMinus = ur - 2.0f * sqrt(g * hr);
+    float betaPlus = 2.0f * sqrt(g * (hInlet + 0.13535f)) + hInlet * sqrt(g / 0.13535f);
+    return float2(1.0f / 16.0f / g * (betaPlus - betaMinus) * (betaPlus - betaMinus),
+                  0.5f * (betaPlus + betaMinus));
+}
+
+// Ghost (h, qx, qy) of a west-edge benchmark inflow from the leaf's means.
+// wave = {west inlet level, dt, finest dx, time at the end of the step}.
+inline float3 mw_inflow_ghost(uint marker, float3 mean, float meanBed,
+                              float4 wave, float g, float tolerance) {
+    if (marker == MW_GHOST_WAVE) {
+        float up = mean.x > tolerance ? mean.y / mean.x : 0.0f;
+        float2 out = mw_non_reflective_wave(wave.x, wave.y, wave.z, mean.x, up, 0.13535f, 0.0f, g);
+        return float3(out.x - meanBed, out.x * out.y, mean.z);
+    }
+    // wavemaker speed (bc2amr.f, as cuda/adaptive)
+    float s = 0.6f * exp(-0.25f * (wave.w - 14.75f) * (wave.w - 14.75f));
+    float v0 = mean.x > tolerance ? mean.y / mean.x : 0.0f;
+    return float3(mean.x, (2.0f * s - v0) * mean.x, mean.z);
+}
+
+inline uint mw_neighbor_at_local_level(uint other, uint localLevel,
+                                      uint maxLevel) {
+    if (other >= MW_GHOST_MIN) return other;
+    while (node_geometry(other, maxLevel).w > localLevel)
+        other = (other - 1u) / 4u;
+    return other;
+}
+
+inline float3 mw_physical(float3 u, uint axis, float g, float tolerance) {
+    if (u.x<tolerance) return float3(0.0f);
+    float h=u.x;
+    float velocity=u[axis+1]/h;
+    float3 flux=float3(u[axis+1],u.y*velocity,u.z*velocity);
+    flux[axis+1] += .5f*g*h*h;
+    return flux;
+}
+
+inline float3 mw_star(float3 u, float bed, float common_bed, float tolerance) {
+    float h=max(0.0f,u.x+bed-common_bed);
+    return float3(h,u.yz*(u.x>tolerance?h/u.x:0.0f));
+}
+
+inline float2 mw_friction_point(float h,float2 q,float n,float g,float dt,
+                                float depthTolerance,float speedTolerance) {
+    if(h<depthTolerance) return float2(0);
+    float2 velocity=q/h;
+    if(abs(velocity.x)<speedTolerance && abs(velocity.y)<speedTolerance) return float2(0);
+    float speed=length(velocity);
+    float cf=g*n*n/pow(h,1.0f/3.0f);
+    float2 source=-cf*velocity*speed;
+    float dx=1+dt*cf/h*(2*velocity.x*velocity.x+velocity.y*velocity.y)/speed;
+    float dy=1+dt*cf/h*(2*velocity.y*velocity.y+velocity.x*velocity.x)/speed;
+    return q+dt*float2(source.x/dx,source.y/dy);
+}
+
+// CUDA adaptive flux_HLL.cuh: two-rarefaction star-state wave speeds and
+// contact-speed selection for transverse momentum, with the same one-sided
+// branches and wet/dry depth threshold.
+inline float3 mw_hll_x(float3 neg, float3 pos, float g, float tolerance) {
+    if (neg.x<tolerance && pos.x<tolerance) return float3(0.0f);
+    float hn=neg.x<tolerance?0.0f:neg.x;
+    float un=neg.x<tolerance?0.0f:neg.y/neg.x;
+    float vn=neg.x<tolerance?0.0f:neg.z/neg.x;
+    float hp=pos.x<tolerance?0.0f:pos.x;
+    float up=pos.x<tolerance?0.0f:pos.y/pos.x;
+    float vp=pos.x<tolerance?0.0f:pos.z/pos.x;
+    float an=sqrt(g*hn), ap=sqrt(g*hp);
+    float starTerm=0.5f*(an+ap)+0.25f*(un-up);
+    float hstar=starTerm*starTerm/g;
+    float ustar=0.5f*(un+up)+an-ap;
+    float astar=sqrt(g*hstar);
+    float sneg=hn<tolerance?up-2.0f*ap:min(un-an,ustar-astar);
+    float spos=hp<tolerance?un+2.0f*an:max(up+ap,ustar+astar);
+    float3 fn=float3(neg.y,un*neg.y+0.5f*g*hn*hn,neg.z*un);
+    float3 fp=float3(pos.y,up*pos.y+0.5f*g*hp*hp,pos.z*up);
+    if (sneg>=0.0f) return fn;
+    if (spos<0.0f) return fp;
+    float3 flux;
+    flux.x=(spos*fn.x-sneg*fp.x+sneg*spos*(hp-hn))/(spos-sneg);
+    flux.y=(spos*fn.y-sneg*fp.y+sneg*spos*(pos.y-neg.y))/(spos-sneg);
+    float smid=(sneg*hp*(up-spos)-spos*hn*(un-sneg)) /
+               (hp*(up-spos)-hn*(un-sneg));
+    flux.z=flux.x*(smid>=0.0f?vn:vp);
+    return flux;
+}
+
+inline float3 mw_hll(float3 neg, float3 pos, uint axis, float g, float tolerance) {
+    if (axis==0) return mw_hll_x(neg,pos,g,tolerance);
+    float3 negRot=float3(neg.x,neg.z,-neg.y);
+    float3 posRot=float3(pos.x,pos.z,-pos.y);
+    float3 flux=mw_hll_x(negRot,posRot,g,tolerance);
+    return float3(flux.x,-flux.z,flux.y);
+}
+
+// CUDA-compatible DG2 operator; CUDA samples each face at its midpoint.
+// The first Legendre residual is formed from opposite-face flux sums. Keep
+// this stencil: multi-point face quadrature creates transverse flux modes
+// absent from CUDA's update and breaks 1-D symmetry over long runs.
+// Scales contain h, qx, qy, z (three orthonormal Legendre modes each).
+// CUDA reads a leaf's own coefficients from its assembled solution (after
+// ghost-cell slope clearing, friction and limiting) but its neighbours from
+// the scale-coefficient tree loaded before those changes: `scales` is the
+// stage view, `tree` the hierarchy.
+kernel void mwdg2_rhs(device const float *scales [[buffer(0)]],
+                      device const uint *active [[buffer(1)]],
+                      device const uint *neighbours [[buffer(2)]],
+                      device float *rhs [[buffer(3)]],
+                      device const float *tree [[buffer(4)]],
+                      device float *edgeRate [[buffer(5)]],
+                      device const float *plainTree [[buffer(6)]],
+                      device const uint *frictioned [[buffer(7)]],
+                      constant uint2 &layout [[buffer(8)]],
+                      constant float4 &physics [[buffer(9)]],
+                      constant float4 &wave [[buffer(10)]],
+                      uint index [[thread_position_in_grid]]) {
+    if (index>=layout.x) return;
+    // frictioned bit 1: the leaf centre lies outside the raster (padding);
+    // dg2_update.cu does not update such leaves.
+    if (frictioned[index] & 2u) {
+        for(uint k=0;k<9;++k) rhs[index*9+k]=0.0f;
+        edgeRate[index]=0.0f;
+        return;
+    }
+    // friction_implicit.cu updates a leaf's neighbour copies only when the
+    // leaf itself is above tol_h and tol_s (bit 0): read the neighbours from
+    // the tree with friction applied (tree) or without (plainTree).
+    if (!(frictioned[index] & 1u)) tree=plainTree;
+    uint node=active[index];
+    uint4 cell=node_geometry(node,layout.y);
+    float dx=physics.x*cell.z,dy=physics.y*cell.z,g=physics.z,tolerance=physics.w;
+    float3 residual[3]={float3(0),float3(0),float3(0)};
+    uint faceCount=layout.x*4u;
+    uint recordsStart=(faceCount+4u)&~3u;
+    device const uint4 *segments=(device const uint4 *)(neighbours+recordsStart);
+    uint other[4];
+    for(uint face=0;face<4;++face) {
+        uint begin=neighbours[index*4+face];
+        other[face]=begin<neighbours[index*4+face+1]
+            ? mw_neighbor_at_local_level(segments[begin].x,cell.w,layout.y)
+            : 0xffffffffu;
+    }
+    float2 pN=float2(float(cell.x)+.5f*cell.z,float(cell.y+cell.z));
+    float2 pE=float2(float(cell.x+cell.z),float(cell.y)+.5f*cell.z);
+    float2 pS=float2(float(cell.x)+.5f*cell.z,float(cell.y));
+    float2 pW=float2(float(cell.x),float(cell.y)+.5f*cell.z);
+    float3 bN=mw_basis(cell,pN),bE=mw_basis(cell,pE),bS=mw_basis(cell,pS),bW=mw_basis(cell,pW);
+    float3 n=mw_state(scales,node,bN),e=mw_state(scales,node,bE);
+    float3 s=mw_state(scales,node,bS),w=mw_state(scales,node,bW);
+    float zn=mw_bed(scales,node,bN),ze=mw_bed(scales,node,bE);
+    float zs=mw_bed(scales,node,bS),zw=mw_bed(scales,node,bW);
+    float3 nn=n,ee=e,ss=s,ww=w;
+    float znn=zn,zee=ze,zss=zs,zww=zw;
+    // CUDA add_ghost_cells uses the cell means for a default closed-boundary
+    // ghost and clears all ghost slopes; it also zeros the outward discharge.
+    // Using the local face trace here looks more conservative, but changes the
+    // CUDA boundary Riemann problem and produces a different long-run volume.
+    uint local=node*12;
+    float3 meanState=float3(scales[local]-scales[local+9],
+                            scales[local+3],scales[local+6]);
+    float meanBed=scales[local+9];
+    if(other[0]==0xffffffffu) { nn=meanState; nn.z=0.0f; znn=meanBed; }
+    else if(other[0]==0xfffffffeu) { nn=meanState; nn.x=pow(meanState.z*meanState.z/g,1.0f/3.0f); znn=meanBed; }
+    else {uint4 c=node_geometry(other[0],layout.y);float3 b=mw_basis(c,pN);nn=mw_state(tree,other[0],b);znn=mw_bed(tree,other[0],b);}
+    if(other[1]==0xffffffffu) { ee=meanState; ee.y=0.0f; zee=meanBed; }
+    else if(other[1]==0xfffffffeu) { ee=meanState; ee.x=pow(meanState.y*meanState.y/g,1.0f/3.0f); zee=meanBed; }
+    else {uint4 c=node_geometry(other[1],layout.y);float3 b=mw_basis(c,pE);ee=mw_state(tree,other[1],b);zee=mw_bed(tree,other[1],b);}
+    if(other[2]==0xffffffffu) { ss=meanState; ss.z=0.0f; zss=meanBed; }
+    else if(other[2]==0xfffffffeu) { ss=meanState; ss.x=pow(meanState.z*meanState.z/g,1.0f/3.0f); zss=meanBed; }
+    else {uint4 c=node_geometry(other[2],layout.y);float3 b=mw_basis(c,pS);ss=mw_state(tree,other[2],b);zss=mw_bed(tree,other[2],b);}
+    if(other[3]==0xffffffffu) { ww=meanState; ww.y=0.0f; zww=meanBed; }
+    else if(other[3]==0xfffffffeu) { ww=meanState; ww.x=pow(meanState.y*meanState.y/g,1.0f/3.0f); zww=meanBed; }
+    else if(other[3]>=MW_GHOST_MIN) { ww=mw_inflow_ghost(other[3],meanState,meanBed,wave,g,tolerance); zww=meanBed; }
+    else {uint4 c=node_geometry(other[3],layout.y);float3 b=mw_basis(c,pW);ww=mw_state(tree,other[3],b);zww=mw_bed(tree,other[3],b);}
+
+    // dg2_update.cu updates only leaves whose own or a neighbour's mean depth
+    // (the ghost's for a boundary face) reaches tol_h; the others keep their
+    // state (zero residual here).
+    bool wet=meanState.x>=tolerance;
+    for(uint face=0;face<4;++face) {
+        float hMean;
+        if(other[face]==0xffffffffu) hMean=meanState.x;
+        else if(other[face]>=MW_GHOST_MIN && other[face]<0xfffffffeu)
+            hMean=mw_inflow_ghost(other[face],meanState,meanBed,wave,g,tolerance).x;
+        else if(other[face]==0xfffffffeu) {
+            float qn=(face==0||face==2)?meanState.z:meanState.y;
+            hMean=pow(qn*qn/g,1.0f/3.0f);
+        } else hMean=tree[other[face]*12]-tree[other[face]*12+9];
+        wet=wet||hMean>=tolerance;
+    }
+    edgeRate[index]=0.0f;
+    if(!wet) {
+        for(uint k=0;k<9;++k) rhs[index*9+k]=0.0f;
+        return;
+    }
+    float zne=max(zn,znn),zeeI=max(ze,zee),zse=max(zs,zss),zwe=max(zw,zww);
+    float3 nStar=mw_star(n,zn,zne,tolerance),nnStar=mw_star(nn,znn,zne,tolerance);
+    float3 eStar=mw_star(e,ze,zeeI,tolerance),eeStar=mw_star(ee,zee,zeeI,tolerance);
+    float3 sStar=mw_star(s,zs,zse,tolerance),ssStar=mw_star(ss,zss,zse,tolerance);
+    float3 wStar=mw_star(w,zw,zwe,tolerance),wwStar=mw_star(ww,zww,zwe,tolerance);
+    float3 Fn=mw_hll(nStar,nnStar,1,g,tolerance);
+    float3 Fe=mw_hll(eStar,eeStar,0,g,tolerance);
+    float3 Fs=mw_hll(ssStar,sStar,1,g,tolerance);
+    float3 Fw=mw_hll(wwStar,wStar,0,g,tolerance);
+    // CUDA evaluates the numerical flux directly from the hydrostatic star
+    // states. The bed-source terms below provide the balance; adding a second
+    // hydrostatic pressure correction here double-counts that source.
+    // volume rate out through domain-edge faces (closed, FREE or boundary)
+    edgeRate[index]=(other[0]>=MW_GHOST_MIN?Fn.x*dx:0.0f)-(other[2]>=MW_GHOST_MIN?Fs.x*dx:0.0f)
+                   +(other[1]>=MW_GHOST_MIN?Fe.x*dy:0.0f)-(other[3]>=MW_GHOST_MIN?Fw.x*dy:0.0f);
+    float3 u0x=.5f*(eStar+wStar),u1x=(eStar-wStar)/(2.0f*mw_sqrt3);
+    float3 u0y=.5f*(nStar+sStar),u1y=(nStar-sStar)/(2.0f*mw_sqrt3);
+    residual[0]=-(Fe-Fw)/dx-(Fn-Fs)/dy;
+    residual[1]=-mw_sqrt3/dx*(Fe+Fw-mw_physical(u0x-u1x,0,g,tolerance)-mw_physical(u0x+u1x,0,g,tolerance));
+    residual[2]=-mw_sqrt3/dy*(Fs+Fn-mw_physical(u0y-u1y,1,g,tolerance)-mw_physical(u0y+u1y,1,g,tolerance));
+
+    float etaE=e.x+ze,etaW=w.x+zw,etaN=n.x+zn,etaS=s.x+zs;
+    float zStarE=zeeI-max(0.0f,-(etaE-zeeI));
+    float zStarW=zwe-max(0.0f,-(etaW-zwe));
+    float zStarN=zne-max(0.0f,-(etaN-zne));
+    float zStarS=zse-max(0.0f,-(etaS-zse));
+    float z1x=(zStarE-zStarW)/(2.0f*mw_sqrt3);
+    float z1y=(zStarN-zStarS)/(2.0f*mw_sqrt3);
+    residual[0].y += -2.0f*mw_sqrt3*g*u0x.x*z1x/dx;
+    residual[1].y += -2.0f*mw_sqrt3*g*u1x.x*z1x/dx;
+    residual[0].z += -2.0f*mw_sqrt3*g*u0y.x*z1y/dy;
+    residual[2].z += -2.0f*mw_sqrt3*g*u1y.x*z1y/dy;
+    for (uint field=0; field<3; ++field) for (uint mode=0; mode<3; ++mode)
+        rhs[index*9+field*3+mode]=residual[mode][field];
+}
+
+// Instantaneous outward volume rate on tagged north FREE faces. The host
+// combines the two SSP-RK2 stage rates with equal weights for mass accounting.
+kernel void mwdg2_boundary_flux(device const float *scales [[buffer(0)]],
+                               device const uint *active [[buffer(1)]],
+                               device const uint *neighbours [[buffer(2)]],
+                               device float *rate [[buffer(3)]],
+                               constant uint2 &layout [[buffer(4)]],
+                               constant float4 &physics [[buffer(5)]],
+                               uint index [[thread_position_in_grid]]) {
+    if (index>=layout.x) return;
+    uint node=active[index];
+    uint faceCount=layout.x*4;
+    uint begin=neighbours[index*4],end=neighbours[index*4+1];
+    uint recordsStart=(faceCount+4u)&~3u;
+    device const uint4 *segments=(device const uint4 *)(neighbours+recordsStart);
+    uint4 cell=node_geometry(node,layout.y);
+    float dy=physics.y*cell.z;
+    float total=0.0f;
+    for (uint segment=begin; segment<end; ++segment) if(segments[segment].x==0xfffffffeu)
+      for (uint gauss=0; gauss<2; ++gauss) {
+        float segmentStart=float(segments[segment].y),segmentLength=float(segments[segment].z-segments[segment].y);
+        float tangent=(segmentStart+segmentLength*(.5f+(gauss?1.0f:-1.0f)/(2*mw_sqrt3)))/float(cell.z);
+        float2 point=float2(float(cell.x)+tangent*float(cell.z),float(cell.y+cell.z));
+        float3 basis=mw_basis(cell,point);
+        float3 local=mw_state(scales,node,basis);
+        float3 remote=local;
+        remote.x=pow(local.z*local.z/physics.z,1.0f/3.0f);
+        float bed=mw_bed(scales,node,basis);
+        float3 ls=mw_star(local,bed,bed,physics.w);
+        float3 rs=mw_star(remote,bed,bed,physics.w);
+        float massFlux=mw_hll(ls,rs,1,physics.z,physics.w).x;
+        total += massFlux*dy*segmentLength/(2.0f*float(cell.z));
+    }
+    rate[index]=total;
+}
+
+// CUDA's adaptive loop clears water on NoData leaves before rainfall and the
+// flux update. NoData transitions are protected to finest cells by the host
+// preflags, so the cell-centre lookup identifies the complete leaf.
+kernel void mwdg2_drain_nodata(device float *scales [[buffer(0)]],
+                               device const uint *active [[buffer(1)]],
+                               device const float *dem [[buffer(2)]],
+                               device float *drainedVolume [[buffer(3)]],
+                               constant uint4 &layout [[buffer(4)]],
+                               constant float2 &physics [[buffer(5)]],
+                               uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x) return;
+    drainedVolume[index]=0.0f;
+    uint node=active[index];
+    uint4 cell=node_geometry(node,layout.y);
+    uint x=cell.x+cell.z/2, y=cell.y+cell.z/2;
+    if (x>=layout.z || y>=layout.w) return;
+    uint row=layout.w-1-y;
+    if (abs(dem[row*layout.z+x]-physics.x)<1.0f) {
+        uint p=node*12;
+        float h=scales[p]-scales[p+9];
+        drainedVolume[index]=h*physics.y*float(cell.z*cell.z);
+        scales[p]=scales[p+9]; scales[p+1]=scales[p+10]; scales[p+2]=scales[p+11];
+        scales[p+3]=scales[p+4]=scales[p+5]=0.0f;
+        scales[p+6]=scales[p+7]=scales[p+8]=0.0f;
+    }
+}
+
+// SSP RK2 stage on compact leaves. Bed coefficients never evolve: they are
+// taken from the tree.
+kernel void mwdg2_rk(device const float *initial [[buffer(0)]],
+                     device const float *current [[buffer(1)]],
+                     device const float *rhs [[buffer(2)]],
+                     device const uint *active [[buffer(3)]],
+                     device float *output [[buffer(4)]],
+                     device const float *bed [[buffer(5)]],
+                     constant uint &count [[buffer(6)]],
+                     constant float2 &stage [[buffer(7)]],
+                     uint index [[thread_position_in_grid]]) {
+    if (index>=count) return;
+    uint node=active[index];
+    for (uint mode=0; mode<12; ++mode) {
+        float value=mode<9 ? current[node*12+mode] : bed[node*12+mode];
+        if (mode<9) value=stage.y*initial[node*12+mode]+(1-stage.y)*(value+stage.x*rhs[index*9+mode]);
+        output[node*12+mode]=value;
+    }
+}
+
+inline float mw_minmod(float a, float b, float c) {
+    if (a*b>0.0f && a*c>0.0f)
+        return copysign(min(abs(a),min(abs(b),abs(c))),a);
+    return 0.0f;
+}
+inline float3 mw_component(device const float *u, uint node, uint field) {
+    uint p=node*12+field*3;
+    return float3(u[p],u[p+1],u[p+2]);
+}
+inline float mw_eval_component(float3 c, float3 basis) { return dot(c,basis); }
+
+// CUDA adaptive limit_slopes/get_limited_slopes: only finest leaves are
+// limited; the Krivodonova jump detector decides whether to apply minmod.
+// Results are written separately so adjacent leaves read an immutable state,
+// matching CUDA's assembled neighbour snapshot.
+kernel void mwdg2_limit_slopes(device const float *u [[buffer(0)]],
+                               device const uint *active [[buffer(1)]],
+                               device const uint *neighbours [[buffer(2)]],
+                               device float *limited [[buffer(3)]],
+                               device const float *tree [[buffer(4)]],
+                               device const float *plainTree [[buffer(5)]],
+                               device const uint *frictioned [[buffer(6)]],
+                               constant uint4 &layout [[buffer(7)]],
+                               constant float4 &physics [[buffer(8)]],
+                               constant float &maxDepth [[buffer(9)]],
+                               uint index [[thread_position_in_grid]]) {
+    if (index>=layout.x) return;
+    if (!(frictioned[index] & 1u)) tree=plainTree;
+    uint node=active[index];
+    uint4 cell=node_geometry(node,layout.y);
+    uint out=index*6;
+    uint p=node*12;
+    // CUDA limit_slopes only operates on finest-level cells and skips padding.
+    if (cell.w!=layout.y || cell.x>=layout.z || cell.y>=layout.w) {
+        limited[out]=u[p+1]; limited[out+1]=u[p+2];
+        limited[out+2]=u[p+4]; limited[out+3]=u[p+5];
+        limited[out+4]=u[p+7]; limited[out+5]=u[p+8];
+        return;
+    }
+    float3 local[3]={mw_component(u,node,0),mw_component(u,node,1),mw_component(u,node,2)};
+    float3 z=float3(u[p+9],u[p+10],u[p+11]);
+    float3 remoteMean[4][3], remoteTrace[4][3];
+    float remoteH[4];
+    float2 points[4]={float2(float(cell.x)+0.5f*cell.z,float(cell.y+cell.z)),
+                      float2(float(cell.x+cell.z),float(cell.y)+0.5f*cell.z),
+                      float2(float(cell.x)+0.5f*cell.z,float(cell.y)),
+                      float2(float(cell.x),float(cell.y)+0.5f*cell.z)};
+    for(uint face=0;face<4;++face) {
+        uint faceCount=layout.x*4;
+        uint begin=neighbours[index*4+face];
+        uint recordsStart=(faceCount+4u)&~3u;
+        device const uint4 *segments=(device const uint4 *)(neighbours+recordsStart);
+        uint other=mw_neighbor_at_local_level(segments[begin].x,cell.w,layout.y);
+        // (the benchmark inflow ghosts are limited as closed edges: neither
+        // cuda/adaptive benchmark uses limitslopes)
+        if(other<MW_GHOST_MIN) {
+            for(uint f=0;f<3;++f) remoteMean[face][f]=mw_component(tree,other,f);
+            uint4 otherCell=node_geometry(other,layout.y);
+            float3 b=mw_basis(otherCell,points[face]);
+            for(uint f=0;f<3;++f)
+                remoteTrace[face][f]=float3(mw_eval_component(remoteMean[face][f],b),0,0);
+            remoteH[face]=remoteMean[face][0].x-tree[other*12+9];
+        } else {
+            // CUDA adaptive ghost mean. For FREE, use the critical-depth
+            // ghost and retain momentum; default boundaries zero the normal
+            // momentum in the corresponding flux branch below.
+            float h=local[0].x-z.x;
+            float eta=local[0].x;
+            bool freeFace=other==0xfffffffeu;
+            if(freeFace) {
+                float qn=(face==0||face==2)?local[2].x:local[1].x;
+                h=pow(qn*qn/physics.z,1.0f/3.0f), eta=h+z.x;
+            }
+            remoteMean[face][0]=float3(eta,0,0);
+            remoteMean[face][1]=float3((!freeFace&&(face==1||face==3))?0.0f:local[1].x,0,0);
+            remoteMean[face][2]=float3((!freeFace&&(face==0||face==2))?0.0f:local[2].x,0,0);
+            for(uint f=0;f<3;++f) remoteTrace[face][f]=remoteMean[face][f];
+            remoteH[face]=h;
+        }
+    }
+    float3 faceBasis[4]={float3(1,0,mw_sqrt3),float3(1,mw_sqrt3,0),
+                         float3(1,0,-mw_sqrt3),float3(1,-mw_sqrt3,0)};
+    float minHx=min(local[0].x-z.x,min(remoteH[1],remoteH[3]));
+    float minHy=min(local[0].x-z.x,min(remoteH[0],remoteH[2]));
+    bool limitX=0.05f*maxDepth<minHx;
+    bool limitY=0.05f*maxDepth<minHy;
+    for(uint field=0;field<3;++field) {
+        float3 c=local[field];
+        float normX=max(abs(c.x-c.y),abs(c.x+c.y));
+        float normY=max(abs(c.x-c.z),abs(c.x+c.z));
+        float dse=normX>1e-12f?abs(remoteTrace[1][field].x-mw_eval_component(c,faceBasis[1]))/(0.5f*physics.x*normX):0.0f;
+        float dsw=normX>1e-12f?abs(remoteTrace[3][field].x-mw_eval_component(c,faceBasis[3]))/(0.5f*physics.x*normX):0.0f;
+        float dsn=normY>1e-12f?abs(remoteTrace[0][field].x-mw_eval_component(c,faceBasis[0]))/(0.5f*physics.y*normY):0.0f;
+        float dss=normY>1e-12f?abs(remoteTrace[2][field].x-mw_eval_component(c,faceBasis[2]))/(0.5f*physics.y*normY):0.0f;
+        float sx=(max(dse,dsw)<physics.w)?c.y:mw_minmod(c.y,c.x-remoteMean[3][field].x,remoteMean[1][field].x-c.x);
+        float sy=(max(dsn,dss)<physics.w)?c.z:mw_minmod(c.z,c.x-remoteMean[2][field].x,remoteMean[0][field].x-c.x);
+        if(field==0) {
+            // CUDA limits eta in its assembled h+z view, then converts the
+            // limited slopes back to depth for that temporary view. This
+            // persistent Metal tree stores eta, so keep eta_limited here;
+            // subtracting z here would store h while later kernels subtract
+            // z again when recovering depth.
+            limited[out]=limitX?sx:c.y;
+            limited[out+1]=limitY?sy:c.z;
+        } else {
+            uint k=out+2+(field-1)*2;
+            limited[k]=limitX?sx:c.y;
+            limited[k+1]=limitY?sy:c.z;
+        }
+    }
+}
+
+kernel void mwdg2_apply_limited_slopes(device float *u [[buffer(0)]],
+                                      device const uint *active [[buffer(1)]],
+                                      device const float *limited [[buffer(2)]],
+                                      constant uint &count [[buffer(3)]],
+                                      uint index [[thread_position_in_grid]]) {
+    if(index>=count) return;
+    uint p=active[index]*12, q=index*6;
+    u[p+1]=limited[q]; u[p+2]=limited[q+1];
+    u[p+4]=limited[q+2]; u[p+5]=limited[q+3];
+    u[p+7]=limited[q+4]; u[p+8]=limited[q+5];
+}
+
+// Match CUDA adaptive MWDG2: preserve updated h and slopes exactly, and clear
+// momentum coefficients when the cell-mean depth falls below tol_h.
+kernel void mwdg2_positivity(device float *scales [[buffer(0)]],
+                             device const uint *active [[buffer(1)]],
+                             device uint *invalid [[buffer(2)]],
+                             constant uint &count [[buffer(3)]],
+                             constant float &tolerance [[buffer(4)]],
+                             uint index [[thread_position_in_grid]]) {
+    if (index>=count) return;
+    uint p=active[index]*12;
+    float mean=scales[p]-scales[p+9];
+    bool bad=!isfinite(mean);
+    for (uint k=0; k<12; ++k) bad |= !isfinite(scales[p+k]);
+    invalid[index]=bad;
+    if (mean<tolerance) {
+        for (uint k=3; k<9; ++k) scales[p+k]=0;
+    }
+}
+
+// Reconstruct the four cell-centred output fields on the rectangular LISFLOOD
+// raster from the adaptive leaves. Output planes are H, HU, HV and DEM; the
+// `owners` map is built over the padded 2^L square, while only xsz*ysz cells
+// are written. `geometry = {xsz, ysz, side, maxLevel}`.
+// Prepare raster-scale loss fields from current leaf means. CUDA adaptive
+// losses evaluate the nonlinear soil law at every finest cell using that
+// owning leaf's mean depth, then restrict the depth change to the leaf.
+kernel void mwdg2_loss_prepare(device const float *state [[buffer(0)]],
+                               device const uint *owners [[buffer(1)]],
+                               device float *depth [[buffer(2)]],
+                               device float *qx [[buffer(3)]],
+                               device float *qy [[buffer(4)]],
+                               constant uint4 &layout [[buffer(5)]],
+                               uint index [[thread_position_in_grid]]) {
+    const uint cells = layout.z * layout.w;
+    if (index >= cells) return;
+    const uint x = index % layout.z;
+    const uint row = index / layout.z;
+    const uint y = layout.w - 1 - row;
+    const uint code = morton_dilate(x) | (morton_dilate(y) << 1);
+    const uint node = owners[code];
+    const uint p = node * 12;
+    depth[index] = max(0.0f, state[p] - state[p + 9]);
+    qx[index] = state[p + 3];
+    qy[index] = state[p + 6];
+}
+
+// Restrict raster-scale infiltration/evaporation to each active leaf and
+// apply the same dry-face momentum rules as CUDA apply_losses_adaptive.
+kernel void mwdg2_restrict_losses(device float *state [[buffer(0)]],
+                                 device const uint *active [[buffer(1)]],
+                                 device const float *depth [[buffer(2)]],
+                                 device const float *dem [[buffer(3)]],
+                                 device float *residual [[buffer(4)]],
+                                 device float *removed [[buffer(5)]],  // depth x cells taken
+                                 constant uint4 &layout [[buffer(6)]], // count,L,xsz,ysz
+                                 constant float2 &physics [[buffer(7)]], // nodata,threshold
+                                 uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x) return;
+    removed[index] = 0.0f;
+    const uint node = active[index];
+    const uint4 cell = node_geometry(node, layout.y);
+    const uint xEnd = min(cell.x + cell.z, layout.z);
+    const uint yEnd = min(cell.y + cell.z, layout.w);
+    const uint p = node * 12;
+    const float h = state[p] - state[p + 9];
+    float loss = 0.0f;
+    uint valid = 0;
+    for (uint y = cell.y; y < yEnd; ++y) {
+        const uint row = layout.w - 1 - y;
+        for (uint x = cell.x; x < xEnd; ++x) {
+            const uint raster = row * layout.z + x;
+            if (abs(dem[raster] - physics.x) < 1e-6f) continue;
+            loss += h - depth[raster];
+            ++valid;
+        }
+    }
+    if (valid == 0) return;
+    const float next = max(0.0f, h - loss / float(valid));
+    // The state holds the level eta = z + h: on a high bed a small loss can
+    // round away (one float step of eta at z = 300 m is 3e-5 m). Carry what
+    // the stored level did not take in the residual and report what it took.
+    const float stored = next < h ? (state[p + 9] + next) - state[p + 9] : h;
+    const float correction = (loss - float(valid) * (h - stored)) / float(valid);
+    removed[index] = float(valid) * (h - stored);
+    for (uint y = cell.y; y < yEnd; ++y) {
+        const uint row = layout.w - 1 - y;
+        for (uint x = cell.x; x < xEnd; ++x) {
+            const uint raster = row * layout.z + x;
+            if (abs(dem[raster] - physics.x) < 1e-6f) continue;
+            residual[raster] += correction;
+        }
+    }
+    if (stored == h) return;
+    const float oldDepth = max(h, 0.0f);
+    const float scale = stored > physics.y && oldDepth > 0.0f ? stored / oldDepth : 0.0f;
+    state[p] = state[p + 9] + next;
+    const float h1x = state[p + 1] - state[p + 10];
+    const float h1y = state[p + 2] - state[p + 11];
+    const bool dry = next <= physics.y || mw_sqrt3 * abs(h1x) >= next ||
+                     mw_sqrt3 * abs(h1y) >= next;
+    if (dry) {
+        state[p + 1] = state[p + 10];
+        state[p + 2] = state[p + 11];
+        state[p + 4] = state[p + 5] = 0.0f;
+        state[p + 7] = state[p + 8] = 0.0f;
+    } else {
+        state[p + 4] *= scale; state[p + 5] *= scale;
+        state[p + 7] *= scale; state[p + 8] *= scale;
+    }
+    state[p + 3] *= scale;
+    state[p + 6] *= scale;
+}
+
+// Rain forcing is raster-scale and applied before the next flow CFL/step,
+// using the previously selected dt (the first increment is deliberately 0).
+// Per-leaf restriction keeps heterogeneous dynamic rain conservative.
+kernel void mwdg2_apply_rain(device float *state [[buffer(0)]],
+                             device const uint *active [[buffer(1)]],
+                             device const float *rainRate [[buffer(2)]],
+                             device const float *dem [[buffer(3)]],
+                             constant uint4 &layout [[buffer(4)]], // count,L,xsz,ysz
+                             constant float3 &forcing [[buffer(5)]], // dt,nodata,clampNegative
+                             uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x || forcing.x <= 0.0f) return;
+    const uint node = active[index];
+    const uint4 cell = node_geometry(node, layout.y);
+    const uint xEnd = min(cell.x + cell.z, layout.z);
+    const uint yEnd = min(cell.y + cell.z, layout.w);
+    const uint p = node * 12;
+    const float h = max(0.0f, state[p] - state[p + 9]);
+    float incrementSum = 0.0f;
+    uint valid = 0;
+    for (uint y = cell.y; y < yEnd; ++y) {
+        const uint row = layout.w - 1 - y;
+        for (uint x = cell.x; x < xEnd; ++x) {
+            const uint raster = row * layout.z + x;
+            if (abs(dem[raster] - forcing.y) < 1e-6f) continue;
+            float increment = rainRate[raster] * forcing.x;
+            if (forcing.z > 0.5f) increment = max(-h, increment);
+            else increment = max(0.0f, increment);
+            incrementSum += increment;
+            ++valid;
+        }
+    }
+    if (valid) state[p] += incrementSum / float(valid);
+}
+
+kernel void mwdg2_project_raster(device const float *scales [[buffer(0)]],
+                                 device const uint *owners [[buffer(1)]],
+                                 device float *output [[buffer(2)]],
+                                 constant uint4 &geometry [[buffer(3)]],
+                                 uint index [[thread_position_in_grid]]) {
+    uint cells=geometry.x*geometry.y;
+    if(index>=cells) return;
+    uint x=index%geometry.x;
+    uint row=index/geometry.x;
+    uint y=geometry.y-1-row;
+    uint code=morton_dilate(x)+(morton_dilate(y)<<1);
+    uint node=owners[code];
+    uint4 cell=node_geometry(node,geometry.w);
+    float2 point=float2(float(x)+.5f,float(y)+.5f);
+    float3 basis=mw_basis(cell,point);
+    uint p=node*12;
+    float eta=dot(float3(scales[p],scales[p+1],scales[p+2]),basis);
+    float qx=dot(float3(scales[p+3],scales[p+4],scales[p+5]),basis);
+    float qy=dot(float3(scales[p+6],scales[p+7],scales[p+8]),basis);
+    float z=mw_bed(scales,node,basis);
+    output[index]=eta-z;
+    output[cells+index]=qx;
+    output[2*cells+index]=qy;
+    output[3*cells+index]=z;
+}
+
+// CUDA DG2 CFL estimate evaluated from each adaptive leaf's mean state. CUDA
+// seeds each leaf with initial_tstep, then overwrites wet leaves with their
+// local CFL step; dry leaves retain the seed and can cap the global minimum.
+kernel void mwdg2_cfl(device const float *scales [[buffer(0)]],
+                      device const uint *active [[buffer(1)]],
+                      device float *localDt [[buffer(2)]],
+                      constant uint2 &layout [[buffer(3)]], // count, maxLevel
+                      constant float4 &physics [[buffer(4)]], // dx, dy, g, CFL
+                      constant float &depthThreshold [[buffer(5)]],
+                      constant float &maxDt [[buffer(6)]],
+                      uint index [[thread_position_in_grid]]) {
+    if(index>=layout.x) return;
+    uint node=active[index];
+    uint4 cell=node_geometry(node,layout.y);
+    uint p=node*12;
+    float h=scales[p]-scales[p+9];
+    if(!isfinite(h) || h<depthThreshold) { localDt[index]=maxDt; return; }
+    float qx=scales[p+3],qy=scales[p+6];
+    float speed=sqrt(max(physics.z*h,0.0f));
+    float dx=physics.x*cell.z,dy=physics.y*cell.z;
+    float dtX=physics.w*dx/(abs(qx/h)+speed);
+    float dtY=physics.w*dy/(abs(qy/h)+speed);
+    localDt[index]=min(dtX,dtY);
+}
+
+// friction_implicit.cu for the leaves themselves: a leaf whose mean depth is
+// below tol_h or mean speed below tol_s only has its mean discharge zeroed (its
+// slopes are kept) and does not update its neighbour copies (flag 0); the
+// others get the full update below (flag 1). params = {g, dt, tol_h, tol_s}.
+kernel void mwdg2_friction_own(device float *scales [[buffer(0)]],
+                               device const uint *active [[buffer(1)]],
+                               device const float *manning [[buffer(2)]],
+                               device uint *frictioned [[buffer(3)]],
+                               constant uint &count [[buffer(4)]],
+                               constant float4 &params [[buffer(5)]],
+                               uint index [[thread_position_in_grid]]) {
+    if(index>=count) return;
+    uint p=active[index]*12;
+    float h=scales[p]-scales[p+9];
+    bool belowDepth=h<params.z;
+    float ux=belowDepth?0.0f:scales[p+3]/h, uy=belowDepth?0.0f:scales[p+6]/h;
+    bool belowSpeed=abs(ux)<params.w && abs(uy)<params.w;
+    frictioned[index]=(frictioned[index]&2u)|((belowDepth||belowSpeed)?0u:1u);
+    if(belowDepth||belowSpeed) { scales[p+3]=0.0f; scales[p+6]=0.0f; return; }
+    float n=manning[index],g=params.x,dt=params.y;
+    float z0=scales[p+9],zx=scales[p+10],zy=scales[p+11];
+    float h0=scales[p]-z0,hx=scales[p+1]-zx,hy=scales[p+2]-zy;
+    float2 q0=mw_friction_point(h0,float2(scales[p+3],scales[p+6]),n,g,dt,params.z,params.w);
+    float2 qxm=mw_friction_point(h0-hx,float2(scales[p+3]-scales[p+4],scales[p+6]-scales[p+7]),n,g,dt,params.z,params.w);
+    float2 qxp=mw_friction_point(h0+hx,float2(scales[p+3]+scales[p+4],scales[p+6]+scales[p+7]),n,g,dt,params.z,params.w);
+    float2 qym=mw_friction_point(h0-hy,float2(scales[p+3]-scales[p+5],scales[p+6]-scales[p+8]),n,g,dt,params.z,params.w);
+    float2 qyp=mw_friction_point(h0+hy,float2(scales[p+3]+scales[p+5],scales[p+6]+scales[p+8]),n,g,dt,params.z,params.w);
+    scales[p+3]=q0.x; scales[p+6]=q0.y;
+    scales[p+4]=.5f*(qxp.x-qxm.x); scales[p+7]=.5f*(qxp.y-qxm.y);
+    scales[p+5]=.5f*(qyp.x-qym.x); scales[p+8]=.5f*(qyp.y-qym.y);
+}
+
+// CUDA's implicit Manning source is applied to the mean and the four DG2
+// directional Gauss pairs, then the momentum slopes are reconstructed.
+kernel void mwdg2_friction(device float *scales [[buffer(0)]],
+                           device const uint *active [[buffer(1)]],
+                           device const float *manning [[buffer(2)]],
+                           constant uint &count [[buffer(3)]],
+                           constant float4 &params [[buffer(4)]],
+                           uint index [[thread_position_in_grid]]) {
+    if(index>=count) return;
+    uint p=active[index]*12;
+    float n=manning[index],g=params.x,dt=params.y;
+    float tolH=params.z,tolSpeed=params.w;
+    float z0=scales[p+9],zx=scales[p+10],zy=scales[p+11];
+    float h0=scales[p]-z0,hx=scales[p+1]-zx,hy=scales[p+2]-zy;
+    float2 q0=mw_friction_point(h0,float2(scales[p+3],scales[p+6]),n,g,dt,tolH,tolSpeed);
+    float2 qxm=mw_friction_point(h0-hx,float2(scales[p+3]-scales[p+4],scales[p+6]-scales[p+7]),n,g,dt,tolH,tolSpeed);
+    float2 qxp=mw_friction_point(h0+hx,float2(scales[p+3]+scales[p+4],scales[p+6]+scales[p+7]),n,g,dt,tolH,tolSpeed);
+    float2 qym=mw_friction_point(h0-hy,float2(scales[p+3]-scales[p+5],scales[p+6]-scales[p+8]),n,g,dt,tolH,tolSpeed);
+    float2 qyp=mw_friction_point(h0+hy,float2(scales[p+3]+scales[p+5],scales[p+6]+scales[p+8]),n,g,dt,tolH,tolSpeed);
+    scales[p+3]=q0.x; scales[p+6]=q0.y;
+    scales[p+4]=.5f*(qxp.x-qxm.x); scales[p+7]=.5f*(qxp.y-qxm.y);
+    scales[p+5]=.5f*(qyp.x-qym.x); scales[p+8]=.5f*(qyp.y-qym.y);
+}
+
+// ---------------------------------------------------------------------------
+// HWFV1 (cuda/adaptive with solver_type HWFV1): Haar wavelets on the cell
+// means and a first-order finite-volume update. The tree keeps the MWDG2
+// layout (12 floats per node) with all slope modes zero.
+
+// encode_and_thresh_flow (HWFV1): parent mean = average of the four children;
+// details alpha, beta, gamma (encode_details.cuh), stored in the alpha_0,
+// beta_0 and gamma_0 slots of the MWDG2 detail layout.
+kernel void hwfv1_encode_level(device float *scales [[buffer(0)]],
+                               device float *details [[buffer(1)]],
+                               constant uint2 &level [[buffer(2)]],
+                               uint index [[thread_position_in_grid]]) {
+    if (index >= level.y) return;
+    uint node = level.x + index;
+    for (uint field = 0; field < 4; ++field) {
+        float c0 = scales[(node*4+1)*12 + field*3], c1 = scales[(node*4+2)*12 + field*3];
+        float c2 = scales[(node*4+3)*12 + field*3], c3 = scales[(node*4+4)*12 + field*3];
+        scales[node*12 + field*3] = .25f*((c0 + c2) + (c1 + c3));
+        scales[node*12 + field*3 + 1] = scales[node*12 + field*3 + 2] = 0.0f;
+        device float *d = details + node*36 + field*9;
+        for (uint k = 0; k < 9; ++k) d[k] = 0.0f;
+        d[0] = .25f*((c0 - c2) + (c1 - c3));
+        d[3] = .25f*((c0 + c2) - (c1 + c3));
+        d[6] = .25f*((c0 - c2) - (c1 - c3));
+    }
+}
+
+// fv1_update.cu: leaves whose own or neighbour mean depth reaches tol_h are
+// updated; the others keep their state and initial_tstep as CFL value.
+// view: the leaf's own state after friction; tree: neighbour means (friction
+// applied, as CUDA's d_neighbours). params = {dt, initial_tstep, CFL, tol_q}.
+kernel void hwfv1_update(device const float *view [[buffer(0)]],
+                         device const uint *active [[buffer(1)]],
+                         device const uint *neighbours [[buffer(2)]],
+                         device float *out [[buffer(3)]],
+                         device const float *tree [[buffer(4)]],
+                         device float *localDt [[buffer(5)]],
+                         device float *edgeRate [[buffer(6)]],
+                         device const float *plainTree [[buffer(7)]],
+                         device const uint *frictioned [[buffer(8)]],
+                         constant uint2 &layout [[buffer(9)]],
+                         constant float4 &physics [[buffer(10)]],
+                         constant float4 &params [[buffer(11)]],
+                         constant float4 &wave [[buffer(12)]],
+                         uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x) return;
+    if (!(frictioned[index] & 1u)) tree = plainTree;
+    uint node = active[index];
+    uint4 cell = node_geometry(node, layout.y);
+    float dx = physics.x*cell.z, dy = physics.y*cell.z, g = physics.z, tol = physics.w;
+    uint p = node*12;
+    for (uint k = 0; k < 12; ++k) out[p+k] = view[p+k];
+    localDt[index] = params.y;
+    edgeRate[index] = 0.0f;
+    float z = view[p+9], h = view[p] - z;
+    float3 U = float3(h, view[p+3], view[p+6]);
+    uint recordsStart = (layout.x*4u + 4u) & ~3u;
+    device const uint4 *segments = (device const uint4 *)(neighbours + recordsStart);
+    float3 Un[4]; float zn[4];
+    bool wet = h >= tol;
+    for (uint face = 0; face < 4; ++face) {
+        uint begin = neighbours[index*4 + face];
+        uint other = begin < neighbours[index*4 + face + 1]
+            ? mw_neighbor_at_local_level(segments[begin].x, cell.w, layout.y) : 0xffffffffu;
+        uint normal = (face == 0 || face == 2) ? 2u : 1u;  // N/S: qy, E/W: qx
+        if (other == 0xffffffffu) {            // add_ghost_cells: closed default
+            Un[face] = U; Un[face][normal] = 0.0f; zn[face] = z;
+        } else if (other == 0xfffffffeu) {     // FREE: critical depth, momentum kept
+            Un[face] = U; Un[face].x = pow(U[normal]*U[normal]/g, 1.0f/3.0f); zn[face] = z;
+        } else if (other >= MW_GHOST_MIN) {    // benchmark west inflow
+            Un[face] = mw_inflow_ghost(other, U, z, wave, g, tol); zn[face] = z;
+        } else {
+            uint o = other*12;
+            zn[face] = tree[o+9];
+            Un[face] = float3(tree[o] - tree[o+9], tree[o+3], tree[o+6]);
+        }
+        wet = wet || Un[face].x >= tol;
+    }
+    if (!wet) return;
+    float eta = h + z;
+    float zN = max(z, zn[0]), zE = max(z, zn[1]), zS = max(z, zn[2]), zW = max(z, zn[3]);
+    float3 nNeg = mw_star(U, z, zN, tol), nPos = mw_star(Un[0], zn[0], zN, tol);
+    float3 eNeg = mw_star(U, z, zE, tol), ePos = mw_star(Un[1], zn[1], zE, tol);
+    float3 sNeg = mw_star(Un[2], zn[2], zS, tol), sPos = mw_star(U, z, zS, tol);
+    float3 wNeg = mw_star(Un[3], zn[3], zW, tol), wPos = mw_star(U, z, zW, tol);
+    float3 Fn = mw_hll(nNeg, nPos, 1, g, tol), Fe = mw_hll(eNeg, ePos, 0, g, tol);
+    float3 Fs = mw_hll(sNeg, sPos, 1, g, tol), Fw = mw_hll(wNeg, wPos, 0, g, tol);
+    uint edge[4];
+    for (uint face = 0; face < 4; ++face) {
+        uint begin = neighbours[index*4 + face];
+        edge[face] = begin < neighbours[index*4 + face + 1] ? segments[begin].x : 0xffffffffu;
+    }
+    edgeRate[index] = (edge[0] >= MW_GHOST_MIN ? Fn.x*dx : 0.0f) - (edge[2] >= MW_GHOST_MIN ? Fs.x*dx : 0.0f)
+                    + (edge[1] >= MW_GHOST_MIN ? Fe.x*dy : 0.0f) - (edge[3] >= MW_GHOST_MIN ? Fw.x*dy : 0.0f);
+    // get_bed_src_x / get_bed_src_y
+    float zStarW = zW - max(0.0f, -(eta - zW)), zStarE = zE - max(0.0f, -(eta - zE));
+    float zStarS = zS - max(0.0f, -(eta - zS)), zStarN = zN - max(0.0f, -(eta - zN));
+    float bedX = g*0.5f*(wPos.x + eNeg.x)*(zStarE - zStarW)/dx;
+    float bedY = g*0.5f*(sPos.x + nNeg.x)*(zStarN - zStarS)/dy;
+    float dt = params.x;
+    float qx = U.y, qy = U.z;
+    h  = h  - dt*(Fe.x - Fw.x)/dx;
+    qx = qx - dt*((Fe.y - Fw.y)/dx + bedX);
+    qy = qy - dt*(Fe.z - Fw.z)/dx;
+    h  = h  - dt*(Fn.x - Fs.x)/dy;
+    qx = qx - dt*(Fn.y - Fs.y)/dy;
+    qy = qy - dt*((Fn.z - Fs.z)/dy + bedY);
+    bool belowDepth = h < tol;
+    bool belowDischarge = abs(qx) < params.w && abs(qy) < params.w;
+    if (belowDepth || belowDischarge) { qx = 0.0f; qy = 0.0f; }
+    if (!belowDepth) {
+        float c = sqrt(g*h);
+        localDt[index] = min(params.z*dx/(abs(qx/h) + c), params.z*dy/(abs(qy/h) + c));
+    }
+    out[p] = h + z; out[p+3] = qx; out[p+6] = qy;
+}
+
+// add_ghost_cells.cu, prescribed boundaries on finest leaves at the domain
+// edge: HFIX/HVAR set the leaf's own mean depth to max(0, level - z0); QFIX/
+// QVAR set it to q*dt/dx_finest (as CUDA does). cell[i] = type*4 + side, or
+// -1 (sides N,E,S,W = 0..3; types as metal_adaptive_bc.h). delta[i] receives
+// the volume added (m3). params = {dt, dx_finest, cell area, unused}.
+kernel void adaptive_boundary_cells(device float *view [[buffer(0)]],
+                                    device const uint *active [[buffer(1)]],
+                                    device const int *cell [[buffer(2)]],
+                                    device float *delta [[buffer(3)]],
+                                    constant uint &count [[buffer(4)]],
+                                    constant float4 &inlet [[buffer(5)]],
+                                    constant float4 &params [[buffer(6)]],
+                                    uint index [[thread_position_in_grid]]) {
+    if (index >= count) return;
+    delta[index] = 0.0f;
+    int c = cell[index];
+    if (c < 0) return;
+    uint p = active[index]*12;
+    int type = c / 4, side = c % 4;
+    float z = view[p+9], h = view[p] - z, value = inlet[side];
+    float hNew = (type == 2 || type == 3) ? max(0.0f, value - z) : value*params.x/params.y;
+    view[p] = hNew + z;
+    delta[index] = (hNew - h)*params.z;
+}
diff --git a/metal/adaptive/metal_mwdg2_input.metal b/metal/adaptive/metal_mwdg2_input.metal
new file mode 100644
index 0000000..9773c0c
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_input.metal
@@ -0,0 +1,77 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// Project four cell-centred raster planes into the three orthonormal DG2
+// modes used by the adaptive MWDG2 state. Input planes are field-major in the
+// order h, qx, qy, z; rows increase south-to-north (the CUDA reader's internal
+// layout after it reverses ESRI's north-to-south rows). Output is cell-major,
+// then variable-major in the order eta=h+z, qx, qy, z, then mode 0, x, y.
+// Each cell uses the four nearest cell samples as its corners. CUDA's
+// interface construction duplicates the first internal row at interface
+// rows 0 and 1, so cell y uses samples max(y-1,0) and y. At the outer raster
+// boundary the nearest edge sample is copied. The host replaces -9999 with
+// wall_height before upload, as read_raster_file does.
+kernel void mwdg2_project_input(device const float *raster [[buffer(0)]],
+                                device float *modes [[buffer(1)]],
+                                constant uint4 &geometry [[buffer(2)]],
+                                uint index [[thread_position_in_grid]]) {
+    const uint width = geometry.x;
+    const uint height = geometry.y;
+    const uint cells = width * height;
+    if (index >= cells) return;
+
+    const uint x = index % width;
+    const uint y = index / width;
+    // read_and_project_modes_dg2: the node on the raster's east edge takes the
+    // edge cell (geometry.z = raster width), not the wall padding
+    const uint validWidth = geometry.z ? geometry.z : width;
+    const uint xp = x + 1 == validWidth ? x : min(x + 1, width - 1);
+    const uint ym = y == 0 ? 0 : y - 1;
+
+    const uint nw = y * width + x;
+    const uint ne = y * width + xp;
+    const float inv4sqrt3 = 0.14433756729740643f;
+
+    float corner[4][4]; // variable (h,qx,qy,z), corner (SW,SE,NW,NE)
+    for (uint variable = 0; variable < 4; ++variable) {
+        const device float *plane = raster + variable * cells;
+        corner[variable][0] = plane[ym * width + x];
+        corner[variable][1] = plane[ym * width + xp];
+        corner[variable][2] = plane[nw];
+        corner[variable][3] = plane[ne];
+    }
+    // Metal deviation (geometry.w = wall_height as float bits, 0 = off): a
+    // corner on a NoData wall takes the projected cell's own values. CUDA
+    // averages the wall height into the cell, so a basin cell with NoData to
+    // its north or east gets a bed thousands of metres high (Alzette: -60 m
+    // depths; CUDA MWDG2 collapses there).
+    // A NoData cell keeps its own (wall) values at every corner.
+    const float wall = as_type<float>(geometry.w);
+    if (wall > 0.0f) {
+        const bool ownWall = corner[3][2] >= wall;
+        for (uint c = 0; c < 4; ++c) {
+            if (!ownWall && corner[3][c] < wall) continue;
+            for (uint variable = 0; variable < 4; ++variable)
+                corner[variable][c] = corner[variable][2];
+        }
+    }
+
+    // The state stores free surface rather than depth. Projecting eta from
+    // nodal sums preserves lake-at-rest cancellation with the independently
+    // projected bed coefficients.
+    corner[0][0] += corner[3][0];
+    corner[0][1] += corner[3][1];
+    corner[0][2] += corner[3][2];
+    corner[0][3] += corner[3][3];
+
+    for (uint variable = 0; variable < 4; ++variable) {
+        const float swv = corner[variable][0];
+        const float sev = corner[variable][1];
+        const float nwv = corner[variable][2];
+        const float nev = corner[variable][3];
+        const uint base = index * 12 + variable * 3;
+        modes[base] = 0.25f * (swv + sev + nwv + nev);
+        modes[base + 1] = (nev - nwv + sev - swv) * inv4sqrt3;
+        modes[base + 2] = (nev - sev + nwv - swv) * inv4sqrt3;
+    }
+}
diff --git a/metal/adaptive/metal_mwdg2_mesh.h b/metal/adaptive/metal_mwdg2_mesh.h
new file mode 100644
index 0000000..a97d9da
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_mesh.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include "metal_mwdg2_scan.h"
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace lis { namespace metal { namespace mwdg2 {
+
+struct AdaptiveMesh {
+  __strong id<MTLBuffer> split = nil;
+  __strong id<MTLBuffer> owners = nil;
+  __strong id<MTLBuffer> leafFlags = nil;
+  __strong id<MTLBuffer> prefix = nil;
+  __strong id<MTLBuffer> active = nil;
+  __strong id<MTLBuffer> nodes = nil;
+  __strong id<MTLBuffer> neighbours = nil;
+  __strong id<MTLBuffer> unbalanced = nil;
+  uint32_t activeCount = 0;
+  std::vector<uint32_t> activeHost;
+
+  AdaptiveMesh() = default;
+  AdaptiveMesh(const AdaptiveMesh &) = delete;
+  AdaptiveMesh &operator=(const AdaptiveMesh &) = delete;
+  AdaptiveMesh(AdaptiveMesh &&other) noexcept { moveFrom(other); }
+  AdaptiveMesh &operator=(AdaptiveMesh &&other) noexcept {
+    if (this != &other) { clear(); moveFrom(other); }
+    return *this;
+  }
+  void clear() noexcept {
+    split = nil; owners = nil; leafFlags = nil; prefix = nil;
+    active = nil; nodes = nil; neighbours = nil; unbalanced = nil;
+    activeCount = 0; activeHost.clear();
+  }
+private:
+  void moveFrom(AdaptiveMesh &other) noexcept {
+    split = other.split; other.split = nil;
+    owners = other.owners; other.owners = nil;
+    leafFlags = other.leafFlags; other.leafFlags = nil;
+    prefix = other.prefix; other.prefix = nil;
+    active = other.active; other.active = nil;
+    nodes = other.nodes; other.nodes = nil;
+    neighbours = other.neighbours; other.neighbours = nil;
+    unbalanced = other.unbalanced; other.unbalanced = nil;
+    activeCount = other.activeCount; other.activeCount = 0;
+    activeHost = std::move(other.activeHost);
+  }
+public:
+};
+
+// Runs CUDA-style MRA significance selection, ungraded compaction, and
+// arbitrary-level adaptive face-neighbour discovery for breadth-first Morton
+// tree buffers. Neighbor CSR records use CUDA's common coarser face level.
+// Input/output coefficient buffers use MWDG2's 12 float coefficients per node.
+class AdaptiveMeshBuilder {
+public:
+  AdaptiveMeshBuilder(id<MTLDevice> device, id<MTLLibrary> library,
+                      id<MTLCommandQueue> queue);
+  AdaptiveMesh select(id<MTLBuffer> scales, id<MTLBuffer> details,
+                      id<MTLBuffer> preflags, uint32_t maxLevel,
+                      uint32_t nodeCount, float epsilon,
+                      id<MTLBuffer> activeCoefficients = nil,
+                      id<MTLBuffer> activeNodes = nil,
+                      uint32_t activeCount = 0);
+  // "mwdg2_encode_level" (multiwavelets, MWDG2) or "hwfv1_encode_level" (Haar).
+  void setEncodeKernel(const char *name) { encodeKernel_ = name; }
+  float lastNorms[4] = {0, 0, 0, 0};  // eta, qx, qy, z normalizers of the last select
+  // raster size inside the 2^L square: its last row/column is the domain edge
+  void setValidSize(uint32_t width, uint32_t height) { validW_ = width; validH_ = height; }
+
+private:
+  id<MTLDevice> device_;
+  id<MTLLibrary> library_;
+  id<MTLCommandQueue> queue_;
+  TreeScan scan_;
+  std::string encodeKernel_ = "mwdg2_encode_level";
+  uint32_t validW_ = 0, validH_ = 0;
+  std::unordered_map<std::string, id<MTLComputePipelineState>> pipelines_;
+  id<MTLComputePipelineState> pipeline(const char *name);
+  void dispatch(const char *name, const std::vector<id<MTLBuffer>> &buffers,
+                const void *args, size_t argSize, uint32_t count,
+                uint32_t width = 64);
+  AdaptiveMesh build(const uint8_t *significant, uint32_t maxLevel,
+                     uint32_t nodeCount, uint32_t finestCount);
+};
+
+} } } // namespace lis::metal::mwdg2
+#endif
diff --git a/metal/adaptive/metal_mwdg2_mesh.mm b/metal/adaptive/metal_mwdg2_mesh.mm
new file mode 100644
index 0000000..67a44d7
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_mesh.mm
@@ -0,0 +1,318 @@
+#ifdef __APPLE__
+#include "metal_mwdg2_mesh.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#import <Foundation/Foundation.h>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <stdexcept>
+
+namespace lis { namespace metal { namespace mwdg2 {
+namespace {
+uint32_t levelOffset(uint32_t level) {
+  return static_cast<uint32_t>((((uint64_t)1 << (2 * level)) - 1) / 3);
+}
+uint32_t levelCount(uint32_t level) { return 1u << (2 * level); }
+uint32_t mortonDilate(uint32_t v) {
+  v = (v | (v << 8)) & 0x00ff00ffu;
+  v = (v | (v << 4)) & 0x0f0f0f0fu;
+  v = (v | (v << 2)) & 0x33333333u;
+  return (v | (v << 1)) & 0x55555555u;
+}
+uint32_t mortonContract(uint32_t v) {
+  v &= 0x55555555u;
+  v = (v | (v >> 1)) & 0x33333333u;
+  v = (v | (v >> 2)) & 0x0f0f0f0fu;
+  v = (v | (v >> 4)) & 0x00ff00ffu;
+  return (v | (v >> 8)) & 0x0000ffffu;
+}
+struct NodeGeometry { uint32_t x, y, span, level; };
+NodeGeometry geometry(uint32_t node, uint32_t maxLevel) {
+  uint32_t start=0, count=1, level=0;
+  while (node >= start+count) { start+=count; count*=4; ++level; }
+  uint32_t code=node-start, span=1u<<(maxLevel-level);
+  return {mortonContract(code)*span, mortonContract(code>>1)*span, span, level};
+}
+
+id<MTLBuffer> makeBuffer(id<MTLDevice> device, size_t bytes, bool zero = true) {
+  if (!bytes) bytes = sizeof(uint32_t);
+  id<MTLBuffer> buffer = [device newBufferWithLength:bytes
+                                           options:MTLResourceStorageModeShared];
+  if (!buffer) throw std::runtime_error("Cannot allocate adaptive MWDG2 buffer");
+  if (zero) std::memset(buffer.contents, 0, bytes);
+  return buffer;
+}
+}
+
+AdaptiveMeshBuilder::AdaptiveMeshBuilder(id<MTLDevice> device,
+                                         id<MTLLibrary> library,
+                                         id<MTLCommandQueue> queue)
+    : device_(device), library_(library), queue_(queue), scan_(device, library, queue) {
+  if (!device_ || !library || !queue_)
+    throw std::invalid_argument("Adaptive mesh builder needs Metal device, library, and queue");
+  // Validate that the complete production mesh pipeline is in this library.
+  for (const char *name : {"mwdg2_encode_level", "mwdg2_normalize_detail_maxima",
+                           "mwdg2_normalize_flow_detail_maxima",
+                           "mwdg2_threshold_level", "mwdg2_regularise_upward",
+                           "mwdg2_propagate_extra_significance", "mwdg2_owner_map",
+                           "mwdg2_grade", "mwdg2_leaf_flags", "mwdg2_compact",
+                           "mwdg2_leaf_neighbours"})
+    pipeline(name);
+}
+
+id<MTLComputePipelineState> AdaptiveMeshBuilder::pipeline(const char *name) {
+  auto found = pipelines_.find(name);
+  if (found != pipelines_.end()) return found->second;
+  id<MTLFunction> function = [library_ newFunctionWithName:
+      [NSString stringWithUTF8String:name]];
+  if (!function)
+    throw std::runtime_error(std::string("Missing adaptive MWDG2 kernel: ") + name);
+  NSError *error = nil;
+  id<MTLComputePipelineState> state =
+      [device_ newComputePipelineStateWithFunction:function error:&error];
+  if (!state)
+    throw std::runtime_error(std::string("Cannot create adaptive MWDG2 pipeline: ") +
+                             error.localizedDescription.UTF8String);
+  pipelines_.emplace(name, state);
+  return state;
+}
+
+void AdaptiveMeshBuilder::dispatch(const char *name,
+                                   const std::vector<id<MTLBuffer>> &buffers,
+                                   const void *args, size_t argSize,
+                                   uint32_t count, uint32_t width) {
+  id<MTLComputePipelineState> state = pipeline(name);
+  @autoreleasepool {
+    id<MTLCommandBuffer> command = [queue_ commandBuffer];
+    id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
+    [encoder setComputePipelineState:state];
+    for (NSUInteger i = 0; i < buffers.size(); ++i)
+      [encoder setBuffer:buffers[i] offset:0 atIndex:i];
+    if (args && argSize) [encoder setBytes:args length:argSize atIndex:buffers.size()];
+    [encoder dispatchThreadgroups:MTLSizeMake((count + width - 1) / width, 1, 1)
+             threadsPerThreadgroup:MTLSizeMake(width, 1, 1)];
+    [encoder endEncoding];
+    [command commit];
+    [command waitUntilCompleted];
+    if (command.status == MTLCommandBufferStatusError)
+      throw std::runtime_error(command.error.localizedDescription.UTF8String);
+  }
+}
+
+AdaptiveMesh AdaptiveMeshBuilder::select(id<MTLBuffer> scales,
+                                         id<MTLBuffer> details,
+                                         id<MTLBuffer> preflags,
+                                         uint32_t maxLevel,
+                                         uint32_t nodeCount,
+                                         float epsilon,
+                                         id<MTLBuffer> activeCoefficients,
+                                         id<MTLBuffer> activeNodes,
+                                         uint32_t activeCount) {
+  if (!scales || !details || maxLevel == 0 || maxLevel > 15 || epsilon < 0.0f)
+    throw std::invalid_argument("Invalid MWDG2 MRA selection inputs");
+  const uint32_t finestCount = levelCount(maxLevel);
+  const uint32_t finestOffset = levelOffset(maxLevel);
+  const uint32_t internalCount = finestOffset;
+  if (nodeCount != finestOffset + finestCount)
+    throw std::invalid_argument("MWDG2 node count does not match maximum tree level");
+
+  static double prof[6] = {0, 0, 0, 0, 0, 0};
+  static long calls = 0;
+  const bool profile = std::getenv("LISFLOOD_MWDG2_PROFILE") != nullptr;
+  auto now = []() { return std::chrono::duration<double>(
+      std::chrono::steady_clock::now().time_since_epoch()).count(); };
+  double t0 = now();
+  // CUDA encoding order: finest-to-coarsest, so each parent sees its four
+  // already encoded child polynomials.
+  for (int level = static_cast<int>(maxLevel) - 1; level >= 0; --level) {
+    uint32_t args[2] = {levelOffset(level), levelCount(level)};
+    dispatch(encodeKernel_.c_str(), {scales, details}, args, sizeof(args), args[1]);
+  }
+
+  if (profile) { double t = now(); prof[0] += t - t0; t0 = t; }
+  // CUDA computes the normalizers over active leaf scaling coefficients (the
+  // initial mesh is finest-level). Keep the reduction on Metal and retain the
+  // CUDA floor of 1.0, including its observed qy <- qx0 behavior.
+  if (activeCount && (!activeCoefficients || !activeNodes))
+    throw std::invalid_argument("MWDG2 active normalization requires both coefficient and node buffers");
+  const uint32_t reductionCount = activeCount ? activeCount : finestCount;
+  const uint32_t groups = (reductionCount + 255) / 256;
+  id<MTLBuffer> dummyActive = activeNodes ? activeNodes : makeBuffer(device_, sizeof(uint32_t));
+  id<MTLBuffer> partials = makeBuffer(device_, size_t(groups) * 4 * sizeof(float));
+  id<MTLBuffer> normBuffer = makeBuffer(device_, 4 * sizeof(float));
+  struct ScaleArgs { uint32_t count, useActive, finestOffset, groupCount; };
+  ScaleArgs scaleArgs{reductionCount, activeCount ? 1u : 0u, finestOffset, groups};
+  dispatch("mwdg2_reduce_scale_partials",
+           {activeCoefficients ? activeCoefficients : scales, dummyActive, partials},
+           &scaleArgs, sizeof(scaleArgs), groups * 256, 256);
+  dispatch("mwdg2_reduce_scale_final", {partials, normBuffer}, &groups,
+           sizeof(groups), 4, 4);
+
+  std::memcpy(lastNorms, normBuffer.contents, sizeof(lastNorms));
+  id<MTLBuffer> componentMaxima = makeBuffer(device_,
+      size_t(internalCount) * 4 * sizeof(float));
+  dispatch("mwdg2_reduce_detail_maxima", {details, componentMaxima}, &internalCount,
+           sizeof(internalCount), internalCount * 4);
+  id<MTLBuffer> normalized = makeBuffer(device_, size_t(nodeCount) * sizeof(float));
+  dispatch("mwdg2_normalize_detail_maxima",
+           {componentMaxima, normBuffer, normalized}, &internalCount,
+           sizeof(internalCount), internalCount);
+  id<MTLBuffer> flowNormalized = makeBuffer(device_, size_t(nodeCount) * sizeof(float));
+  dispatch("mwdg2_normalize_flow_detail_maxima",
+           {componentMaxima, normBuffer, flowNormalized}, &internalCount,
+           sizeof(internalCount), internalCount);
+
+  if (profile) { double t = now(); prof[1] += t - t0; t0 = t; }
+  id<MTLBuffer> significant = makeBuffer(device_, nodeCount);
+  // Finest-level significance entries have no detail threshold pass, but
+  // regularise_upward reads them as child flags. Match CUDA zero_details and
+  // prevent allocator contents from spuriously refining their ancestors.
+  std::memset(significant.contents, 0, nodeCount);
+  id<MTLBuffer> flags = makeBuffer(device_, nodeCount);
+  if (preflags) std::memcpy(flags.contents, preflags.contents, nodeCount);
+  for (int level = static_cast<int>(maxLevel) - 1; level >= 0; --level) {
+    struct Args { uint32_t offset, count, level, maxLevel; float epsilon; };
+    Args args{levelOffset(level), levelCount(level), (uint32_t)level,
+              maxLevel, epsilon};
+    dispatch("mwdg2_threshold_level", {normalized, flags, significant},
+             &args, sizeof(args), args.count);
+  }
+  if (std::getenv("LISFLOOD_MWDG2_DUMP_MRA")) {
+    const float *d = static_cast<const float *>(details.contents);
+    const float *n = static_cast<const float *>(normalized.contents);
+    const uint8_t *s = static_cast<const uint8_t *>(significant.contents);
+    const float *scale = static_cast<const float *>(scales.contents);
+    std::fprintf(stderr, "MWDG2_MRA normalizers eta=%.9g qx=%.9g qy=%.9g z=%.9g\n",
+        static_cast<const float *>(normBuffer.contents)[0],
+        static_cast<const float *>(normBuffer.contents)[1],
+        static_cast<const float *>(normBuffer.contents)[2],
+        static_cast<const float *>(normBuffer.contents)[3]);
+    for (uint32_t l=0, off=0; l<maxLevel; ++l) {
+      const uint32_t count=levelCount(l);
+      for (uint32_t code=0; code<count; ++code) {
+        uint32_t node=off+code;
+        float zm=0;
+        for (uint32_t k=0;k<9;++k) zm=std::max(zm,std::fabs(d[node*36+3*9+k]));
+        if (std::getenv("LISFLOOD_MWDG2_DUMP_MRA_ALL") || zm>0 || s[node]) {
+          std::fprintf(stderr,"MWDG2_MRA node=%u level=%u code=%u sig=%u norm=%.9g zmax=%.9g zdetails=",node,l,code,s[node],n[node],zm);
+          for(uint32_t k=0;k<9;++k) std::fprintf(stderr," %.9g",d[node*36+27+k]);
+          std::fprintf(stderr," etadetails=");
+          for(uint32_t k=0;k<9;++k) std::fprintf(stderr," %.9g",d[node*36+k]);
+          std::fprintf(stderr," etascale=(%.9g %.9g %.9g) zscale=(%.9g %.9g %.9g) children=",scale[node*12],scale[node*12+1],scale[node*12+2],scale[node*12+9],scale[node*12+10],scale[node*12+11]);
+          for(uint32_t child=0;child<4;++child) {
+            const float *c=scale+(node*4+1+child)*12+9;
+            const float *e=scale+(node*4+1+child)*12;
+            std::fprintf(stderr," [%u:eta %.9g,%.9g,%.9g z %.9g,%.9g,%.9g]",child,e[0],e[1],e[2],c[0],c[1],c[2]);
+          }
+          std::fprintf(stderr,"\n");
+        }
+      }
+      off+=count;
+    }
+  }
+  for (int level = static_cast<int>(maxLevel) - 1; level >= 0; --level) {
+    uint32_t args[3] = {levelOffset(level), levelOffset(level + 1),
+                        levelCount(level)};
+    dispatch("mwdg2_regularise_upward", {significant}, args, sizeof(args), args[2]);
+  }
+  for (uint32_t level = 0; level + 1 < maxLevel; ++level) {
+    struct Args { uint32_t parentOffset, childOffset, parentCount, level, maxLevel;
+                  float epsilon, extraFactor; };
+    Args args{levelOffset(level), levelOffset(level + 1), levelCount(level),
+              level, maxLevel, epsilon, std::pow(2.0f, 2.5f)};
+    dispatch("mwdg2_propagate_extra_significance", {significant, flowNormalized},
+             &args, sizeof(args), args.parentCount);
+  }
+  if (profile) { double t = now(); prof[2] += t - t0; t0 = t; }
+  AdaptiveMesh built = build(static_cast<const uint8_t *>(significant.contents), maxLevel,
+                             nodeCount, finestCount);
+  if (profile) {
+    prof[3] += now() - t0;
+    if (++calls % 200 == 0)
+      std::printf("mesh select profile (s): encode %.2f normalise %.2f threshold %.2f build %.2f\n",
+                  prof[0], prof[1], prof[2], prof[3]);
+  }
+  return built;
+}
+
+AdaptiveMesh AdaptiveMeshBuilder::build(const uint8_t *significant,
+                                        uint32_t maxLevel,
+                                        uint32_t nodeCount,
+                                        uint32_t finestCount) {
+  AdaptiveMesh mesh;
+  mesh.split = makeBuffer(device_, size_t(nodeCount) * sizeof(uint32_t));
+  auto *split = static_cast<uint32_t *>(mesh.split.contents);
+  for (uint32_t node = 0; node < nodeCount; ++node)
+    split[node] = significant[node] ? 1u : 0u;
+
+  mesh.owners = makeBuffer(device_, size_t(finestCount) * sizeof(uint32_t));
+  dispatch("mwdg2_owner_map", {mesh.split, mesh.owners}, &maxLevel,
+           sizeof(maxLevel), finestCount);
+
+  mesh.leafFlags = makeBuffer(device_, size_t(nodeCount) * sizeof(uint32_t));
+  dispatch("mwdg2_leaf_flags", {mesh.split, mesh.leafFlags}, &nodeCount,
+           sizeof(nodeCount), nodeCount);
+  mesh.prefix = makeBuffer(device_, size_t(nodeCount) * sizeof(uint32_t));
+  mesh.activeCount = scan_.scan(mesh.leafFlags, mesh.prefix, nodeCount);
+  if (!mesh.activeCount || mesh.activeCount > finestCount)
+    throw std::runtime_error("Adaptive MWDG2 selected an invalid number of leaves");
+  mesh.active = makeBuffer(device_, size_t(mesh.activeCount) * sizeof(uint32_t));
+  mesh.nodes = makeBuffer(device_, size_t(nodeCount) * sizeof(uint32_t));
+  auto *nodes = static_cast<uint32_t *>(mesh.nodes.contents);
+  for (uint32_t node = 0; node < nodeCount; ++node) nodes[node] = node;
+  dispatch("mwdg2_compact", {mesh.leafFlags, mesh.prefix, mesh.active},
+           &nodeCount, sizeof(nodeCount), nodeCount);
+  mesh.activeHost.assign(static_cast<uint32_t *>(mesh.active.contents),
+                         static_cast<uint32_t *>(mesh.active.contents) + mesh.activeCount);
+  // CUDA walks the ungraded tree and resolves a face neighbor at the coarser
+  // of the two face levels. When the actual neighbor is finer, this is its
+  // ancestor at the local leaf's level. Store one face segment per face in a
+  // CSR layout so arbitrary level gaps need no 2:1 grading or fixed slots.
+  const uint32_t side=1u<<maxLevel, faceCount=mesh.activeCount*4;
+  const uint32_t *owner=static_cast<const uint32_t *>(mesh.owners.contents);
+  const uint32_t recordsStart=(faceCount+4u)&~3u; // uint4 alignment in Metal
+  std::vector<uint32_t> packed(recordsStart,0);
+  std::vector<uint32_t> records;
+  records.reserve(size_t(mesh.activeCount)*16);
+  for (uint32_t i=0;i<mesh.activeCount;++i) {
+    NodeGeometry c=geometry(mesh.activeHost[i],maxLevel);
+    for (uint32_t face=0;face<4;++face) {
+      packed[i*4+face]=static_cast<uint32_t>(records.size()/4);
+      int x=static_cast<int>(c.x+c.span/2), y=static_cast<int>(c.y+c.span/2);
+      if(face==0) y=static_cast<int>(c.y+c.span);
+      if(face==1) x=static_cast<int>(c.x+c.span);
+      if(face==2) y=static_cast<int>(c.y)-1;
+      if(face==3) x=static_cast<int>(c.x)-1;
+      uint32_t id=0xffffffffu;
+      // find_neighbours.cu: N/E from the leaf's north-east finest cell, S/W
+      // from its south-west one; that cell on the last raster row/column (or
+      // the square's) has no neighbour on that face.
+      const int vw=static_cast<int>(validW_?validW_:side), vh=static_cast<int>(validH_?validH_:side);
+      const int xne=static_cast<int>(c.x+c.span-1), yne=static_cast<int>(c.y+c.span-1);
+      const bool border=(face==0 && (yne==vh-1 || yne==static_cast<int>(side)-1)) ||
+                        (face==1 && (xne==vw-1 || xne==static_cast<int>(side)-1)) ||
+                        (face==2 && c.y==0) || (face==3 && c.x==0);
+      if(!border && x>=0 && y>=0 && x<static_cast<int>(side) && y<static_cast<int>(side)) {
+        id=owner[mortonDilate(static_cast<uint32_t>(x)) |
+                 (mortonDilate(static_cast<uint32_t>(y))<<1)];
+        NodeGeometry other=geometry(id,maxLevel);
+        while(other.level>c.level) { id=(id-1u)/4u; other=geometry(id,maxLevel); }
+      }
+      records.push_back(id); records.push_back(0); records.push_back(c.span); records.push_back(0);
+    }
+  }
+  packed[faceCount]=static_cast<uint32_t>(records.size()/4);
+  const size_t packedBytes=(packed.size()+records.size())*sizeof(uint32_t);
+  mesh.neighbours=makeBuffer(device_,packedBytes);
+  auto *dst=static_cast<uint32_t *>(mesh.neighbours.contents);
+  std::memcpy(dst,packed.data(),packed.size()*sizeof(uint32_t));
+  std::memcpy(dst+packed.size(),records.data(),records.size()*sizeof(uint32_t));
+  return mesh;
+}
+
+} } } // namespace lis::metal::mwdg2
+#endif
diff --git a/metal/adaptive/metal_mwdg2_minicase.metal b/metal/adaptive/metal_mwdg2_minicase.metal
new file mode 100644
index 0000000..a9162d7
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_minicase.metal
@@ -0,0 +1,165 @@
+#include <metal_stdlib>
+using namespace metal;
+
+constant float mini_sqrt3 = 1.7320508075688772f;
+
+inline uint mini_dilate(uint v) {
+    v = (v | (v << 8)) & 0x00ff00ffu;
+    v = (v | (v << 4)) & 0x0f0f0f0fu;
+    v = (v | (v << 2)) & 0x33333333u;
+    return (v | (v << 1)) & 0x55555555u;
+}
+
+inline uint4 mini_geometry(uint node, uint maxLevel) {
+    uint start = 0, count = 1, level = 0;
+    while (node >= start + count) { start += count; count *= 4; ++level; }
+    uint code = node - start, span = 1u << (maxLevel - level);
+    uint x = 0, y = 0;
+    for (uint b = 0; b < 16; ++b) {
+        x |= ((code >> (2*b)) & 1u) << b;
+        y |= ((code >> (2*b + 1)) & 1u) << b;
+    }
+    return uint4(x * span, y * span, span, level);
+}
+
+// Restrict the updated adaptive DG2 polynomial exactly onto every finest
+// cell. A linear polynomial remains linear under affine cell restriction.
+// Persistent MWDG2 state remains eta=h+z,qx,qy,z throughout the update.
+// The bed (modes 9-11) is not written: the finest level keeps the input bed,
+// as CUDA's scale coefficients do, so coarsening never smooths it.
+kernel void mwdg2_mini_expand_finest(device const float *hydro [[buffer(0)]],
+                                     device const uint *owners [[buffer(1)]],
+                                     device float *scales [[buffer(2)]],
+                                     constant uint2 &layout [[buffer(3)]],
+                                     uint pixel [[thread_position_in_grid]]) {
+    uint side = 1u << layout.y;
+    uint cells = side * side;
+    if (pixel >= cells) return;
+    uint x = pixel % side, y = pixel / side;
+    uint code = mini_dilate(x) | (mini_dilate(y) << 1);
+    uint owner = owners[code];
+    uint4 cell = mini_geometry(owner, layout.y);
+    float xi = 2.0f * (float(x) + 0.5f - float(cell.x)) / float(cell.z) - 1.0f;
+    float yi = 2.0f * (float(y) + 0.5f - float(cell.y)) / float(cell.z) - 1.0f;
+    float invSpan = 1.0f / float(cell.z);
+    uint outNode = (cells - 1) / 3 + code;
+    for (uint mode = 0; mode < 3; ++mode) {
+        uint p = owner * 12;
+        uint q = outNode * 12;
+        float eta = hydro[p] + mini_sqrt3 * (hydro[p+1] * xi + hydro[p+2] * yi);
+        if (mode == 0) {
+            scales[q] = eta;
+            scales[q+3] = hydro[p+3] + mini_sqrt3 * (hydro[p+4] * xi + hydro[p+5] * yi);
+            scales[q+6] = hydro[p+6] + mini_sqrt3 * (hydro[p+7] * xi + hydro[p+8] * yi);
+        } else if (mode == 1) {
+            scales[q+1] = hydro[p+1] * invSpan;
+            scales[q+4] = hydro[p+4] * invSpan;
+            scales[q+7] = hydro[p+7] * invSpan;
+        } else {
+            scales[q+2] = hydro[p+2] * invSpan;
+            scales[q+5] = hydro[p+5] * invSpan;
+            scales[q+8] = hydro[p+8] * invSpan;
+        }
+    }
+}
+
+kernel void mwdg2_mini_cfl(device const float *hydro [[buffer(0)]],
+                           device const uint *active [[buffer(1)]],
+                           device float *timesteps [[buffer(2)]],
+                           constant uint2 &layout [[buffer(3)]],
+                           constant float4 &physics [[buffer(4)]],
+                           constant float2 &control [[buffer(5)]],
+                           uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x) return;
+    uint node = active[index];
+    uint4 cell = mini_geometry(node, layout.y);
+    uint p = node * 12;
+    float h = max(hydro[p] - hydro[p+9], 0.0f);
+    if (h <= control.y) { timesteps[index] = INFINITY; return; }
+    float ux = hydro[p+3] / h, uy = hydro[p+6] / h;
+    float c = sqrt(physics.z * h);
+    float dx = physics.x * float(cell.z), dy = physics.y * float(cell.z);
+    float tx = dx / (abs(ux) + c), ty = dy / (abs(uy) + c);
+    timesteps[index] = control.x * min(tx, ty);
+}
+
+// Cell-centre raster output in internal south-to-north row order:
+// planes are depth, free-surface elevation, qx, qy.
+kernel void mwdg2_mini_project_output(device const float *scales [[buffer(0)]],
+                                      device float *raster [[buffer(1)]],
+                                      constant uint2 &layout [[buffer(2)]],
+                                      uint pixel [[thread_position_in_grid]]) {
+    uint side = 1u << layout.y, cells = side * side;
+    if (pixel >= cells) return;
+    uint x = pixel % side, y = pixel / side;
+    uint code = mini_dilate(x) | (mini_dilate(y) << 1);
+    uint node = (cells - 1) / 3 + code;
+    uint p = node * 12;
+    raster[pixel] = scales[p] - scales[p+9];
+    raster[cells + pixel] = scales[p];
+    raster[2*cells + pixel] = scales[p+3];
+    raster[3*cells + pixel] = scales[p+6];
+}
+
+// End-of-step expansion used for remeshing. CUDA refines a leaf by decoding
+// with zero details, which gives the children the parent's water level over
+// their own (finest) beds: on a bed that varies inside the leaf some children
+// get negative depths and others water that was not there (+/-10 m on the
+// Alzette slopes with HWFV1). Here a leaf keeps CUDA's restriction when every
+// finest cell stays at or below its water level, and otherwise gives every
+// finest cell the leaf's mean depth over its own bed (same volume, no negative
+// depths). Pass 1 flags such leaves; pass 2 writes the finest cells.
+kernel void mwdg2_expand_flags(device const float *hydro [[buffer(0)]],
+                               device const uint *owners [[buffer(1)]],
+                               device const float *scales [[buffer(2)]],
+                               device atomic_uint *flags [[buffer(3)]],
+                               constant uint2 &layout [[buffer(4)]],
+                               uint pixel [[thread_position_in_grid]]) {
+    uint side = 1u << layout.y;
+    uint cells = side * side;
+    if (pixel >= cells) return;
+    uint x = pixel % side, y = pixel / side;
+    uint code = mini_dilate(x) | (mini_dilate(y) << 1);
+    uint owner = owners[code];
+    uint4 cell = mini_geometry(owner, layout.y);
+    if (cell.z == 1) return;
+    float xi = 2.0f * (float(x) + 0.5f - float(cell.x)) / float(cell.z) - 1.0f;
+    float yi = 2.0f * (float(y) + 0.5f - float(cell.y)) / float(cell.z) - 1.0f;
+    uint p = owner * 12;
+    float eta = hydro[p] + mini_sqrt3 * (hydro[p+1] * xi + hydro[p+2] * yi);
+    float z = scales[((cells - 1) / 3 + code) * 12 + 9];
+    if (eta < z) atomic_store_explicit(&flags[owner], 1u, memory_order_relaxed);
+}
+
+kernel void mwdg2_expand_finest_positive(device const float *hydro [[buffer(0)]],
+                                         device const uint *owners [[buffer(1)]],
+                                         device float *scales [[buffer(2)]],
+                                         device const uint *flags [[buffer(3)]],
+                                         constant uint2 &layout [[buffer(4)]],
+                                         uint pixel [[thread_position_in_grid]]) {
+    uint side = 1u << layout.y;
+    uint cells = side * side;
+    if (pixel >= cells) return;
+    uint x = pixel % side, y = pixel / side;
+    uint code = mini_dilate(x) | (mini_dilate(y) << 1);
+    uint owner = owners[code];
+    uint4 cell = mini_geometry(owner, layout.y);
+    float xi = 2.0f * (float(x) + 0.5f - float(cell.x)) / float(cell.z) - 1.0f;
+    float yi = 2.0f * (float(y) + 0.5f - float(cell.y)) / float(cell.z) - 1.0f;
+    float invSpan = 1.0f / float(cell.z);
+    uint p = owner * 12, q = ((cells - 1) / 3 + code) * 12;
+    if (flags[owner]) {
+        float depth = hydro[p] - hydro[p+9];      // the leaf's mean depth
+        scales[q] = scales[q+9] + depth;
+        scales[q+1] = scales[q+10];
+        scales[q+2] = scales[q+11];
+    } else {
+        scales[q] = hydro[p] + mini_sqrt3 * (hydro[p+1] * xi + hydro[p+2] * yi);
+        scales[q+1] = hydro[p+1] * invSpan;
+        scales[q+2] = hydro[p+2] * invSpan;
+    }
+    scales[q+3] = hydro[p+3] + mini_sqrt3 * (hydro[p+4] * xi + hydro[p+5] * yi);
+    scales[q+6] = hydro[p+6] + mini_sqrt3 * (hydro[p+7] * xi + hydro[p+8] * yi);
+    scales[q+4] = hydro[p+4] * invSpan; scales[q+5] = hydro[p+5] * invSpan;
+    scales[q+7] = hydro[p+7] * invSpan; scales[q+8] = hydro[p+8] * invSpan;
+}
diff --git a/metal/adaptive/metal_mwdg2_mra.metal b/metal/adaptive/metal_mwdg2_mra.metal
new file mode 100644
index 0000000..b48f1d9
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_mra.metal
@@ -0,0 +1,362 @@
+#include <metal_stdlib>
+using namespace metal;
+#include "mwdg2_transform.h"
+
+inline uint morton_dilate(uint value) {
+    value = (value | (value << 8)) & 0x00ff00ffu;
+    value = (value | (value << 4)) & 0x0f0f0f0fu;
+    value = (value | (value << 2)) & 0x33333333u;
+    return (value | (value << 1)) & 0x55555555u;
+}
+
+inline uint morton_contract(uint value) {
+    value &= 0x55555555u;
+    value = (value | (value >> 1)) & 0x33333333u;
+    value = (value | (value >> 2)) & 0x0f0f0f0fu;
+    value = (value | (value >> 4)) & 0x00ff00ffu;
+    return (value | (value >> 8)) & 0x0000ffffu;
+}
+
+inline uint4 node_geometry(uint node, uint maximum_level) {
+    uint start = 0, count = 1, level = 0;
+    while (node >= start + count) { start += count; count *= 4; ++level; }
+    uint code = node - start, span = 1u << (maximum_level - level);
+    return uint4(morton_contract(code) * span,
+                 morton_contract(code >> 1) * span, span, level);
+}
+
+inline uint owner_at(device const uint *owners, int x, int y, uint side) {
+    if (x < 0 || y < 0 || x >= int(side) || y >= int(side)) return 0xffffffffu;
+    return owners[morton_dilate(uint(x)) | (morton_dilate(uint(y)) << 1)];
+}
+
+// Grading proposals use atomics because multiple finest interfaces can
+// request the same coarse leaf. The owner map is immutable in this pass.
+// Rebuild ownership between passes; at most L passes are needed.
+kernel void mwdg2_grade(device const uint *owners [[buffer(0)]],
+                        device atomic_uint *split [[buffer(1)]],
+                        constant uint &maximum_level [[buffer(2)]],
+                        uint code [[thread_position_in_grid]]) {
+    uint side = 1u << maximum_level;
+    if (code >= side*side) return;
+    uint owner = owners[code];
+    uint level = node_geometry(owner, maximum_level).w;
+    int x = int(morton_contract(code)), y = int(morton_contract(code >> 1));
+    uint neighbours[2] = {owner_at(owners,x+1,y,side),owner_at(owners,x,y+1,side)};
+    for (uint i=0; i<2; ++i) {
+        uint other=neighbours[i];
+        if (other==0xffffffffu) continue;
+        uint other_level=node_geometry(other,maximum_level).w;
+        if (level+1<other_level)
+            atomic_store_explicit(split+owner,1u,memory_order_relaxed);
+        if (other_level+1<level)
+            atomic_store_explicit(split+other,1u,memory_order_relaxed);
+    }
+}
+
+// Stable compaction consumes the exclusive prefix computed by the generic
+// tree scan. Breadth-first node IDs uniquely retain level and Morton code.
+kernel void mwdg2_compact(device const uint *flags [[buffer(0)]],
+                          device const uint *prefix [[buffer(1)]],
+                          device uint *active [[buffer(2)]],
+                          constant uint &count [[buffer(3)]],
+                          uint node [[thread_position_in_grid]]) {
+    if (node<count && flags[node]) active[prefix[node]]=node;
+}
+
+// Two entries per face, N/E/S/W. Equal entries mean one neighbour covers
+// the full face; different entries mean two finer leaves cover its halves.
+// The full-face verification flags meshes requiring further 2:1 grading.
+kernel void mwdg2_leaf_neighbours(device const uint *active [[buffer(0)]],
+                                 device const uint *owners [[buffer(1)]],
+                                 device uint *neighbours [[buffer(2)]],
+                                 device uint *unbalanced [[buffer(3)]],
+                                 constant uint2 &layout [[buffer(4)]],
+                                 uint index [[thread_position_in_grid]]) {
+    if (index >= layout.x) return;
+    uint4 cell = node_geometry(active[index], layout.y);
+    uint side = 1u << layout.y;
+    uint q0 = cell.z / 4, q1 = min(cell.z - 1, (3 * cell.z) / 4);
+    int x = int(cell.x), y = int(cell.y), span = int(cell.z);
+    uint ids[8] = {
+        owner_at(owners, x+q0, y+span, side), owner_at(owners, x+q1, y+span, side),
+        owner_at(owners, x+span, y+q0, side), owner_at(owners, x+span, y+q1, side),
+        owner_at(owners, x+q0, y-1, side), owner_at(owners, x+q1, y-1, side),
+        owner_at(owners, x-1, y+q0, side), owner_at(owners, x-1, y+q1, side)
+    };
+    bool invalid = false;
+    for (uint i = 0; i < 8; ++i) {
+        neighbours[index*8+i] = ids[i];
+        if (ids[i] != 0xffffffffu) {
+            uint other_level = node_geometry(ids[i], layout.y).w;
+            invalid |= abs(int(other_level)-int(cell.w)) > 1;
+        }
+    }
+    // Catch a small refined patch that quarter-face samples could miss.
+    for (int i = 0; i < span; ++i) {
+        uint face_ids[4] = {owner_at(owners, x+i, y+span, side),
+            owner_at(owners, x+span, y+i, side), owner_at(owners, x+i, y-1, side),
+            owner_at(owners, x-1, y+i, side)};
+        for (uint face = 0; face < 4; ++face)
+            invalid |= face_ids[face] != ids[face*2+(i >= span/2)];
+    }
+    unbalanced[index] = invalid;
+}
+
+// Conservatively project four cell-average fields (eta, qx, qy, z) into
+// finest-level DG nodes. The source layout is field-major; unresolved slopes
+// are initialized to zero. ESRI rows run north to south while adaptive y
+// increases northward, matching CUDA's raster import orientation.
+kernel void mwdg2_import_raster(device const float *raster [[buffer(0)]],
+                               device float *scales [[buffer(1)]],
+                               constant uint4 &geometry [[buffer(2)]],
+                               uint index [[thread_position_in_grid]]) {
+    // geometry = width, height, padded side, finest-level offset.
+    if (index >= geometry.x * geometry.y) return;
+    uint x = index % geometry.x;
+    uint y = geometry.y - 1 - index / geometry.x;
+    uint node = geometry.w + morton_dilate(x) + (morton_dilate(y) << 1);
+    uint cells = geometry.x * geometry.y;
+    for (uint field = 0; field < 4; ++field) {
+        uint p = node * 12 + field * 3;
+        scales[p] = raster[field * cells + index];
+        scales[p + 1] = 0.0f;
+        scales[p + 2] = 0.0f;
+    }
+}
+
+// Bottom-up transform on the persistent tree. One invocation handles one
+// parent and all four physical fields; distinct levels use distinct dispatches.
+kernel void mwdg2_encode_level(device float *scales [[buffer(0)]],
+                              device float *details [[buffer(1)]],
+                              constant uint2 &level [[buffer(2)]],
+                              uint index [[thread_position_in_grid]]) {
+    if (index >= level.y) return;
+    uint node = level.x + index;
+    for (uint field = 0; field < 4; ++field) {
+        for (uint row = 0; row < 12; ++row) {
+            float sum = 0;
+            for (uint child = 0; child < 4; ++child)
+                for (uint mode = 0; mode < 3; ++mode)
+                    sum += mwdg2_coefficient(row, child * 3 + mode) *
+                        scales[(node * 4 + 1 + child) * 12 + field * 3 + mode];
+            if (row < 3) scales[node * 12 + field * 3 + row] = .5f * sum;
+            else details[node * 36 + field * 9 + row - 3] = .5f * sum;
+        }
+    }
+}
+
+kernel void mwdg2_decode_level(device float *scales [[buffer(0)]],
+                              device const float *details [[buffer(1)]],
+                              constant uint2 &level [[buffer(2)]],
+                              uint index [[thread_position_in_grid]]) {
+    if (index >= level.y) return;
+    uint node = level.x + index;
+    for (uint field = 0; field < 4; ++field) {
+        for (uint col = 0; col < 12; ++col) {
+            float sum = 0;
+            for (uint row = 0; row < 12; ++row) {
+                float value = row < 3 ? scales[node * 12 + field * 3 + row] :
+                    details[node * 36 + field * 9 + row - 3];
+                sum += mwdg2_coefficient(row, col) * value;
+            }
+            uint child = col / 3, mode = col % 3;
+            scales[(node * 4 + 1 + child) * 12 + field * 3 + mode] = 2 * sum;
+        }
+    }
+}
+
+// Determine the owning adaptive leaf of each finest cell without a CPU
+// neighbour search. This map also indexes finest-grid soil state.
+kernel void mwdg2_owner_map(device const uint *split [[buffer(0)]],
+                           device uint *owners [[buffer(1)]],
+                           constant uint &maximum_level [[buffer(2)]],
+                           uint index [[thread_position_in_grid]]) {
+    uint count = 1u << (2 * maximum_level);
+    if (index >= count) return;
+    uint node = 0;
+    for (uint level = 0; level < maximum_level && split[node]; ++level) {
+        uint child = (index >> (2 * (maximum_level - level - 1))) & 3;
+        node = node * 4 + 1 + child;
+    }
+    owners[index] = node;
+}
+
+// One work item handles one parent and one physical variable. Three scaling
+// coefficients and nine detail coefficients retain the full DG2 polynomial.
+kernel void mwdg2_encode(device const float *children [[buffer(0)]],
+                        device float *encoded [[buffer(1)]],
+                        constant uint &count [[buffer(2)]],
+                        uint index [[thread_position_in_grid]]) {
+    if (index >= count) return;
+    for (uint row = 0; row < 12; ++row) {
+        float sum = 0;
+        for (uint col = 0; col < 12; ++col)
+            sum += mwdg2_coefficient(row, col) * children[index * 12 + col];
+        encoded[index * 12 + row] = sum * 0.5f;
+    }
+}
+
+kernel void mwdg2_decode(device const float *encoded [[buffer(0)]],
+                        device float *children [[buffer(1)]],
+                        constant uint &count [[buffer(2)]],
+                        uint index [[thread_position_in_grid]]) {
+    if (index >= count) return;
+    for (uint col = 0; col < 12; ++col) {
+        float sum = 0;
+        for (uint row = 0; row < 12; ++row)
+            sum += mwdg2_coefficient(row, col) * encoded[index * 12 + row];
+        children[index * 12 + col] = 2.0f * sum;
+    }
+}
+
+// Node arrays are in breadth-first Morton order: children of node n are
+// 4*n+1 ... 4*n+4. Launch separately for each level, bottom-up, to make every
+// child decision visible before its parent. Preflags protect terrain, masks,
+// boundaries and spatial soil-parameter discontinuities from coarsening.
+kernel void mwdg2_mark_parents(device const float *details [[buffer(0)]],
+                              device const uint *preflags [[buffer(1)]],
+                              device uint *split [[buffer(2)]],
+                              constant uint4 &layout [[buffer(3)]],
+                              constant float4 &normalisers [[buffer(4)]],
+                              constant float &epsilon [[buffer(5)]],
+                              uint index [[thread_position_in_grid]]) {
+    // layout = first node at level, number of nodes, level, maximum level.
+    if (index >= layout.y) return;
+    uint node = layout.x + index;
+    bool significant = preflags[node] != 0;
+    float threshold = epsilon / float(1u << (layout.w - layout.z));
+    for (uint variable = 0; variable < 4; ++variable) {
+        for (uint detail = 0; detail < 9; ++detail) {
+            float magnitude = abs(details[node * 36 + variable * 9 + detail]);
+            significant |= magnitude > threshold * normalisers[variable];
+        }
+    }
+    for (uint child = 0; child < 4; ++child)
+        significant |= split[node * 4 + 1 + child] != 0;
+    split[node] = significant;
+}
+
+// Select only leaves reachable through split ancestors. This is topology
+// selection, not raster masking: a coarsened node replaces its descendants.
+kernel void mwdg2_leaf_flags(device const uint *split [[buffer(0)]],
+                            device uint *leaves [[buffer(1)]],
+                            constant uint &count [[buffer(2)]],
+                            uint node [[thread_position_in_grid]]) {
+    if (node >= count) return;
+    bool selected = split[node] == 0;
+    uint ancestor = node;
+    while (ancestor > 0 && selected) {
+        ancestor = (ancestor - 1) / 4;
+        selected &= split[ancestor] != 0;
+    }
+    leaves[node] = selected;
+}
+
+// GPU reductions for CUDA-style MRA normalization. CUDA's adaptive MWDG2
+// forms eta=h+z before computing its global scale maxima and thresholds eta
+// details alongside qx, qy and z.
+kernel void mwdg2_reduce_scale_partials(
+    device const float *coefficients [[buffer(0)]],
+    device const uint *active [[buffer(1)]],
+    device float *partials [[buffer(2)]],
+    constant uint4 &args [[buffer(3)]], // count, useActive, finestOffset, groupCount
+    uint index [[thread_position_in_grid]],
+    uint lane [[thread_index_in_threadgroup]],
+    uint group [[threadgroup_position_in_grid]]) {
+    threadgroup float local[1024];
+    for (uint field = 0; field < 4; ++field) {
+        float magnitude = 1.0f;
+        if (index < args.x) {
+            uint node = args.y ? active[index] : args.z + index;
+            const float value = coefficients[node * 12 + field * 3];
+            magnitude = max(magnitude, abs(value));
+        }
+        local[field * 256 + lane] = magnitude;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint stride = 128; stride > 0; stride >>= 1) {
+        if (lane < stride) {
+            for (uint field = 0; field < 4; ++field)
+                local[field * 256 + lane] = max(local[field * 256 + lane],
+                                                local[field * 256 + lane + stride]);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (lane == 0)
+        for (uint field = 0; field < 4; ++field)
+            partials[group * 4 + field] = local[field * 256];
+}
+
+kernel void mwdg2_reduce_scale_final(device const float *partials [[buffer(0)]],
+                                     device float *normalizers [[buffer(1)]],
+                                     constant uint &groupCount [[buffer(2)]],
+                                     uint field [[thread_position_in_grid]]) {
+    if (field >= 4) return;
+    const uint sourceField = field == 2 ? 1 : field;
+    float maximum = 1.0f;
+    for (uint group = 0; group < groupCount; ++group)
+        maximum = max(maximum, partials[group * 4 + sourceField]);
+    normalizers[field] = maximum;
+}
+
+kernel void mwdg2_reduce_detail_maxima(device const float *details [[buffer(0)]],
+                                       device float *componentMaxima [[buffer(1)]],
+                                       constant uint &count [[buffer(2)]],
+                                       uint index [[thread_position_in_grid]]) {
+    if (index >= count * 4) return;
+    uint field = index / count, node = index % count;
+    float maximum = 0.0f;
+    for (uint k = 0; k < 9; ++k) {
+        const uint base = node * 36;
+        const float detail = details[base + field * 9 + k];
+        maximum = max(maximum, abs(detail));
+    }
+    componentMaxima[index] = maximum;
+}
+
+// Match CUDA preflag_loss_details: preserve hierarchy nodes that span
+// NoData/domain padding or cell-wise loss-parameter discontinuities.
+kernel void mwdg2_preflag_loss_details(device uchar *preflags [[buffer(0)]],
+                                       device const float *dem [[buffer(1)]],
+                                       device const float *rate [[buffer(2)]],
+                                       device const float *ks [[buffer(3)]],
+                                       device const float *psi [[buffer(4)]],
+                                       device const float *dtheta [[buffer(5)]],
+                                       device const float *fmax [[buffer(6)]],
+                                       constant uint4 &layout [[buffer(7)]],
+                                       constant uint3 &modes [[buffer(8)]],
+                                       constant float &nodata [[buffer(9)]],
+                                       uint node [[thread_position_in_grid]]) {
+    if (node >= layout.x) return;
+    const uint4 cell = node_geometry(node, layout.y);
+    const uint endX = cell.x + cell.z;
+    const uint endY = cell.y + cell.z;
+    int firstIndex = -1;
+    if (cell.x < layout.z && cell.y < layout.w) {
+        uint idx = (layout.w - 1 - cell.y) * layout.z + cell.x;
+        if (abs(dem[idx] - nodata) >= 1e-6f) firstIndex = int(idx);
+    }
+    bool different = false;
+    for (uint y = cell.y; y < endY && !different; ++y) {
+        for (uint x = cell.x; x < endX; ++x) {
+            int idx = -1;
+            if (x < layout.z && y < layout.w) {
+                uint candidate = (layout.w - 1 - y) * layout.z + x;
+                if (abs(dem[candidate] - nodata) >= 1e-6f) idx = int(candidate);
+            }
+            different = (idx < 0) != (firstIndex < 0);
+            if (idx >= 0 && firstIndex >= 0) {
+                different |= modes.x && rate[idx] != rate[firstIndex];
+                if (modes.y) {
+                    different |= ks[idx] != ks[firstIndex] ||
+                                 psi[idx] != psi[firstIndex] ||
+                                 dtheta[idx] != dtheta[firstIndex];
+                    if (modes.z) different |= fmax[idx] != fmax[firstIndex];
+                }
+            }
+            if (different) break;
+        }
+    }
+    if (different) preflags[node] = 1;
+}
diff --git a/metal/adaptive/metal_mwdg2_scan.h b/metal/adaptive/metal_mwdg2_scan.h
new file mode 100644
index 0000000..eabc1f4
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_scan.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace lis {
+namespace metal {
+namespace mwdg2 {
+
+// GPU exclusive scan for adaptive tree flags. Supports arbitrary counts by
+// recursively scanning per-tile totals (tree_scan_tiles itself is a 256 item
+// block scan). The returned total is the sum of all input elements.
+class TreeScan {
+public:
+  TreeScan(id<MTLDevice> device, id<MTLLibrary> library,
+           id<MTLCommandQueue> queue);
+  uint32_t scan(id<MTLBuffer> input, id<MTLBuffer> output, uint32_t count);
+
+private:
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> queue_;
+  id<MTLComputePipelineState> tileScan_;
+  id<MTLComputePipelineState> addOffsets_;
+  uint32_t scanLevel(id<MTLBuffer> input, id<MTLBuffer> output,
+                     uint32_t count);
+  void dispatch(id<MTLComputePipelineState> pipeline,
+                const std::vector<id<MTLBuffer>> &buffers,
+                const void *args, size_t argSize, uint32_t count,
+                uint32_t width);
+};
+
+} // namespace mwdg2
+} // namespace metal
+} // namespace lis
+#endif
diff --git a/metal/adaptive/metal_mwdg2_scan.mm b/metal/adaptive/metal_mwdg2_scan.mm
new file mode 100644
index 0000000..4befa7a
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_scan.mm
@@ -0,0 +1,93 @@
+#ifdef __APPLE__
+#include "metal_mwdg2_scan.h"
+#include <stdexcept>
+#include <string>
+
+namespace lis {
+namespace metal {
+namespace mwdg2 {
+
+TreeScan::TreeScan(id<MTLDevice> device, id<MTLLibrary> library,
+                   id<MTLCommandQueue> queue)
+    : device_(device), queue_(queue) {
+  NSError *error = nil;
+  id<MTLFunction> scanFunction = [library newFunctionWithName:@"tree_scan_tiles"];
+  if (!scanFunction)
+    throw std::runtime_error("Missing Metal kernel tree_scan_tiles");
+  tileScan_ = [device newComputePipelineStateWithFunction:scanFunction error:&error];
+  if (!tileScan_)
+    throw std::runtime_error(std::string("Cannot create tree scan pipeline: ") +
+                             error.localizedDescription.UTF8String);
+  id<MTLFunction> addFunction = [library newFunctionWithName:@"tree_add_tile_offsets"];
+  if (!addFunction)
+    throw std::runtime_error("Missing Metal kernel tree_add_tile_offsets");
+  addOffsets_ = [device newComputePipelineStateWithFunction:addFunction error:&error];
+  if (!addOffsets_)
+    throw std::runtime_error(std::string("Cannot create tree scan offset pipeline: ") +
+                             error.localizedDescription.UTF8String);
+}
+
+void TreeScan::dispatch(id<MTLComputePipelineState> pipeline,
+                        const std::vector<id<MTLBuffer>> &buffers,
+                        const void *args, size_t argSize, uint32_t count,
+                        uint32_t width) {
+  @autoreleasepool {
+    id<MTLCommandBuffer> command = [queue_ commandBuffer];
+    id<MTLComputeCommandEncoder> encoder = [command computeCommandEncoder];
+    [encoder setComputePipelineState:pipeline];
+    for (NSUInteger i = 0; i < buffers.size(); ++i)
+      [encoder setBuffer:buffers[i] offset:0 atIndex:i];
+    if (args && argSize)
+      [encoder setBytes:args length:argSize atIndex:buffers.size()];
+    if (pipeline == tileScan_) {
+      NSUInteger tiles = (count + 255u) / 256u;
+      [encoder dispatchThreadgroups:MTLSizeMake(tiles, 1, 1)
+               threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+    } else {
+      [encoder dispatchThreadgroups:MTLSizeMake((count + width - 1) / width, 1, 1)
+               threadsPerThreadgroup:MTLSizeMake(width, 1, 1)];
+    }
+    [encoder endEncoding];
+    [command commit];
+    [command waitUntilCompleted];
+    if (command.status == MTLCommandBufferStatusError)
+      throw std::runtime_error(command.error.localizedDescription.UTF8String);
+  }
+}
+
+uint32_t TreeScan::scanLevel(id<MTLBuffer> input, id<MTLBuffer> output,
+                             uint32_t count) {
+  if (count == 0) return 0;
+  constexpr uint32_t tileWidth = 256;
+  const uint32_t tiles = (count + tileWidth - 1) / tileWidth;
+  id<MTLBuffer> sums = [device_ newBufferWithLength:tiles * sizeof(uint32_t)
+                                           options:MTLResourceStorageModeShared];
+  if (!sums) throw std::runtime_error("Cannot allocate adaptive scan tile sums");
+  uint32_t tileCount = count;
+  dispatch(tileScan_, {input, output, sums}, &tileCount, sizeof(tileCount), count,
+           tileWidth);
+
+  if (tiles > 1) {
+    id<MTLBuffer> offsets = [device_ newBufferWithLength:tiles * sizeof(uint32_t)
+                                               options:MTLResourceStorageModeShared];
+    if (!offsets) throw std::runtime_error("Cannot allocate adaptive scan offsets");
+    scanLevel(sums, offsets, tiles);
+    dispatch(addOffsets_, {output, offsets}, &count, sizeof(count), count, 256);
+  }
+
+  const auto *in = static_cast<const uint32_t *>(input.contents);
+  const auto *out = static_cast<const uint32_t *>(output.contents);
+  return out[count - 1] + in[count - 1];
+}
+
+uint32_t TreeScan::scan(id<MTLBuffer> input, id<MTLBuffer> output,
+                        uint32_t count) {
+  if (count && (!input || !output))
+    throw std::invalid_argument("Adaptive scan requires input and output buffers");
+  return scanLevel(input, output, count);
+}
+
+} // namespace mwdg2
+} // namespace metal
+} // namespace lis
+#endif
diff --git a/metal/adaptive/metal_mwdg2_selection.metal b/metal/adaptive/metal_mwdg2_selection.metal
new file mode 100644
index 0000000..31e2188
--- /dev/null
+++ b/metal/adaptive/metal_mwdg2_selection.metal
@@ -0,0 +1,153 @@
+#include <metal_stdlib>
+using namespace metal;
+
+// Kernels in this file implement the topology-selection portion of the CUDA
+// adaptive MWDG2 path. Node arrays use CUDA's breadth-first quadtree indexing:
+// level l begins at (4^l - 1) / 3 and a parent owns four consecutive children.
+
+struct MWDG2LevelArgs {
+    uint offset;
+    uint count;
+    uint level;
+    uint maxLevel;
+    float epsilon;
+};
+
+struct MWDG2RegulariseArgs {
+    uint parentOffset;
+    uint childOffset;
+    uint parentCount;
+};
+
+struct MWDG2ExtraArgs {
+    uint parentOffset;
+    uint childOffset;
+    uint parentCount;
+    uint level;
+    uint maxLevel;
+    float epsilon;
+    float extraFactor;
+};
+
+struct MWDG2DecodeArgs {
+    uint parentOffset;
+    uint childOffset;
+    uint childCount;
+};
+
+struct MWDG2LeafArgs {
+    uint nodeCount;
+    uint finestOffset;
+};
+
+// Match DetailMW::get_norm_detail: maximum over eta, qx, qy and bed detail
+// maxima after division by their corresponding global maximum magnitudes.
+// CUDA's raw division is undefined for a zero maximum. Define the limiting
+// behavior explicitly: 0/0 contributes zero, while nonzero/0 is infinite.
+inline float safe_normalized_component(float detail, float normalizer) {
+    detail = abs(detail);
+    if (normalizer > 0.0f) return detail / normalizer;
+    return detail == 0.0f ? 0.0f : INFINITY;
+}
+
+kernel void mwdg2_normalize_detail_maxima(
+    device const float *componentMaxima [[buffer(0)]], // [eta,qx,qy,z][count]
+    device const float *normalizers [[buffer(1)]],     // [eta,qx,qy,z]
+    device float *normalized [[buffer(2)]],
+    constant uint &count [[buffer(3)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= count) return;
+    float n = 0.0f;
+    for (uint field = 0; field < 4; ++field) {
+        n = max(n, safe_normalized_component(componentMaxima[field * count + i], normalizers[field]));
+    }
+    normalized[i] = n;
+}
+
+// CUDA extra_significance uses d_norm_details from the flow encoder, where
+// the bed child coefficients are zero. Terrain z still marks parents through
+// the separate topography preflag, but must not broaden that refinement via
+// the stronger extra-significance threshold.
+kernel void mwdg2_normalize_flow_detail_maxima(
+    device const float *componentMaxima [[buffer(0)]], // [eta,qx,qy,z][count]
+    device const float *normalizers [[buffer(1)]],
+    device float *normalized [[buffer(2)]],
+    constant uint &count [[buffer(3)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= count) return;
+    float n = 0.0f;
+    for (uint field = 0; field < 3; ++field)
+        n = max(n, safe_normalized_component(componentMaxima[field * count + i],
+                                             normalizers[field]));
+    normalized[i] = n;
+}
+
+// CUDA encode_and_thresh_flow: epsilon_local = epsilon / 2^(L-level), then
+// significance is norm >= epsilon_local OR a caller-supplied preflag.
+kernel void mwdg2_threshold_level(
+    device const float *normDetails [[buffer(0)]],
+    device const uchar *preflagged [[buffer(1)]],
+    device uchar *significant [[buffer(2)]],
+    constant MWDG2LevelArgs &args [[buffer(3)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= args.count) return;
+    const float epsilonLocal = args.epsilon / exp2(float(args.maxLevel - args.level));
+    const uint node = args.offset + i;
+    significant[node] = (normDetails[node] >= epsilonLocal || preflagged[node] != 0) ? 1 : 0;
+}
+
+// CUDA regularisation.cu's upward pass: a parent remains significant if it
+// already was, and is set significant whenever any of its four children is.
+kernel void mwdg2_regularise_upward(
+    device uchar *significant [[buffer(0)]],
+    constant MWDG2RegulariseArgs &args [[buffer(1)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= args.parentCount) return;
+    const uint child = args.childOffset + 4 * i;
+    significant[args.parentOffset + i] = significant[args.parentOffset + i] ||
+        significant[child] || significant[child + 1] || significant[child + 2] || significant[child + 3];
+}
+
+// CUDA extra_significance.cu: a significant detail above the stronger
+// level-dependent threshold forces all four children to be refined.
+kernel void mwdg2_propagate_extra_significance(
+    device uchar *significant [[buffer(0)]],
+    device const float *normDetails [[buffer(1)]],
+    constant MWDG2ExtraArgs &args [[buffer(2)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= args.parentCount || args.level + 1 >= args.maxLevel) return;
+    const uint parent = args.parentOffset + i;
+    const float epsilonLocal = args.epsilon / exp2(float(args.maxLevel - args.level));
+    if (significant[parent] && normDetails[parent] >= epsilonLocal * args.extraFactor) {
+        const uint child = args.childOffset + 4 * i;
+        significant[child] = 1;
+        significant[child + 1] = 1;
+        significant[child + 2] = 1;
+        significant[child + 3] = 1;
+    }
+}
+
+// One level of CUDA decoding traversal. A child is reachable exactly when its
+// parent is reachable and significant. The scale/detail inverse transform is
+// intentionally a separate operation; this kernel only constructs topology.
+kernel void mwdg2_decode_topology_level(
+    device const uchar *significant [[buffer(0)]],
+    device uchar *reachable [[buffer(1)]],
+    constant MWDG2DecodeArgs &args [[buffer(2)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= args.childCount) return;
+    const uint parent = args.parentOffset + i / 4;
+    reachable[args.childOffset + i] = reachable[parent] && significant[parent] ? 1 : 0;
+}
+
+kernel void mwdg2_mark_reachable_leaves(
+    device const uchar *significant [[buffer(0)]],
+    device const uchar *reachable [[buffer(1)]],
+    device uchar *leaves [[buffer(2)]],
+    constant MWDG2LeafArgs &args [[buffer(3)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i >= args.nodeCount) return;
+    // At L, the CUDA traversal stops even if details there would exceed the
+    // threshold; no finer grid exists, so every reachable finest node is a leaf.
+    leaves[i] = reachable[i] && (i >= args.finestOffset || !significant[i]) ? 1 : 0;
+}
