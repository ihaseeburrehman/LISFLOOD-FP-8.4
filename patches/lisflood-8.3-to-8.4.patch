diff --git a/CMakeLists.txt b/CMakeLists.txt
index 37a8151..8549cd2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,6 +7,9 @@ endif()
 
 project(lisflood-fp)
 
+option(LISFLOOD_ENABLE_CUDA_MPI "Multi-GPU (MPI) for the CUDA FV1, FV2 and DG2 solvers" OFF)
+option(LISFLOOD_ENABLE_METAL_MPI "Multi-rank (MPI) for the Metal FV1, FV2 and DG2 solvers" OFF)
+
 set(_CONFIG config.default.cmake CACHE FILEPATH "CMake config file")
 include(${_CONFIG})
 
@@ -75,6 +78,11 @@ if (CMAKE_CUDA_COMPILER)
 	set_property(TARGET lisflood PROPERTY CUDA_SEPARABLE_COMPILATION ON)
 	
 	add_compile_definitions(CUDA THRUST_IGNORE_CUB_VERSION_CHECK)
+	if (LISFLOOD_ENABLE_CUDA_MPI)
+		find_package(MPI REQUIRED COMPONENTS CXX)
+		target_link_libraries(lisflood PRIVATE MPI::MPI_CXX)
+		target_compile_definitions(lisflood PRIVATE LISFLOOD_CUDA_MPI=1)
+	endif()
     
 	target_sources(lisflood PRIVATE
 		cuda/cuda_boundary.cu
@@ -83,6 +91,7 @@ if (CMAKE_CUDA_COMPILER)
 		cuda/cuda_geometry.cu
 		cuda/cuda_hll.cu
 		cuda/cuda_max_field.cu
+		cuda/cuda_losses.cu
 		cuda/cuda_rain.cu
 		cuda/cuda_sample.cu
 		cuda/cuda_simulate.cu
@@ -230,6 +239,11 @@ endif()
 
 # Metal GPU back end for FV1 (Apple Silicon)
 if (APPLE)
+	if (LISFLOOD_ENABLE_METAL_MPI)
+		find_package(MPI REQUIRED COMPONENTS CXX)
+		target_link_libraries(lisflood PRIVATE MPI::MPI_CXX)
+		target_compile_definitions(lisflood PRIVATE LISFLOOD_METAL_MPI=1)
+	endif()
 	add_subdirectory(metal)
 	if (METAL_ENABLED)
 		target_link_libraries(lisflood PRIVATE ${METAL_LIBRARY})
